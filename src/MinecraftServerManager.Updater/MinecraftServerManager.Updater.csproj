<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Muhun MCSV Updater</AssemblyName>
    <RootNamespace>MinecraftServerManager.Updater</RootNamespace>
    <Version>1.2.9-beta.8</Version>
    <AssemblyVersion>1.2.9.0</AssemblyVersion>
    <FileVersion>1.2.9.0</FileVersion>
    <InformationalVersion>1.2.9-beta.8</InformationalVersion>
    <AssemblyTitle>X MCSV Updater</AssemblyTitle>
    <Product>X MCSV</Product>
    <Description>Signed A/B product updater and rollback worker for X MCSV.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MinecraftServerManager.Contracts\MinecraftServerManager.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MinecraftServerManager.Updater.Tests" />
  </ItemGroup>

</Project>
