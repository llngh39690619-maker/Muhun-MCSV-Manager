                                               Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                               TextAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding CatalogStatusText}" TextWrapping="Wrap"
                                               TextAlignment="Center" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>

