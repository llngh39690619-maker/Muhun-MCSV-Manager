<UserControl x:Class="MinecraftServerManager.App.Views.ClientWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MinecraftServerManager.App.Controls"
             xmlns:infra="clr-namespace:MinecraftServerManager.App.Infrastructure"
             Background="Transparent"
             Foreground="{DynamicResource TextBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="ClientCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="ClientModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="102" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="ClientMemoryModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClientSectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="ClientFormLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Margin" Value="0,12,0,5" />
        </Style>
        <Style x:Key="LoaderListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="LoaderBorder"
                                Background="{DynamicResource PanelRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="13">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LoaderBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="LoaderBorder" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                <Setter TargetName="LoaderBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="X" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="11" />
                    <TextBlock Text="X MCSV" FontWeight="SemiBold" FontSize="21" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource L10n.main.workspace.server}" Style="{StaticResource ClientModeButton}"
                            Command="{Binding DataContext.ShowServerWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    <Button Content="{DynamicResource L10n.main.workspace.client}" Style="{StaticResource PrimaryButton}" MinWidth="102" Margin="0,0,8,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                              DisplayMemberPath="Username" MinWidth="180" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource L10n.client.account.add}" Command="{Binding AddAccountCommand}" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource L10n.client.account.remove}" Command="{Binding RemoveSelectedAccountCommand}" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource L10n.client.account.signOutAll}" Command="{Binding SignOutAllAccountsCommand}" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource L10n.common.refresh}" Command="{Binding RefreshCatalogCommand}" Margin="0,0,8,0" />
                    <Button Content="⚙" Width="42" MinWidth="42" Padding="4"
                            Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="4,2,4,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource L10n.client.instances.heading}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Instances.Count}" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{DynamicResource L10n.client.instances.countSuffix}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="InstanceBorder" Background="{DynamicResource PanelRaisedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="9" Padding="10">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="InstanceBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="InstanceBorder" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                                    <Setter TargetName="InstanceBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="34" Height="34" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource WindowBrush}" CornerRadius="7">
                                            <TextBlock Text="▣" Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" />
                                        </Border>
                                        <Image infra:LocalImageThumbnail.SourcePath="{Binding IconImagePath}"
                                               infra:LocalImageThumbnail.DecodePixelWidth="96"
                                               infra:LocalImageThumbnail.DecodePixelHeight="96"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding VersionSummary}" Style="{StaticResource MutedText}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                                        <Button Content="▶" ToolTip="{DynamicResource L10n.client.quickLaunch}" Width="30" MinWidth="30" Height="26" Padding="3"
                                                Margin="0,5,0,0" Visibility="{Binding CanQuickLaunch, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.QuickLaunchCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Content="{DynamicResource L10n.client.action.openCatalog}" Command="{Binding OpenCatalogCommand}" Margin="0,0,0,8" />
                        <Button Content="{DynamicResource L10n.client.action.create}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding NewInstanceCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <ScrollViewer Visibility="{Binding IsCreatePage, Converter={StaticResource BoolToVisibility}}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="26" HorizontalAlignment="Stretch">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L10n.client.create.heading}" FontSize="27" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource L10n.client.create.description}"
                                           Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource L10n.common.close}" Command="{Binding CloseCreateCommand}" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource ClientCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L10n.client.create.mode}" Style="{StaticResource ClientSectionHeading}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{DynamicResource L10n.client.create.javaEdition}" Command="{Binding SelectJavaEditionCommand}" MinWidth="130" Margin="0,0,8,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers><DataTrigger Binding="{Binding IsJavaEdition}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{DynamicResource L10n.client.create.bedrockEdition}" Command="{Binding SelectBedrockEditionCommand}" MinWidth="130">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers><DataTrigger Binding="{Binding IsBedrockEdition}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                                <Border Visibility="{Binding IsBedrockEdition, Converter={StaticResource BoolToVisibility}}"
                                        Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource WarningBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource L10n.client.create.bedrockOfficialHeading}"
                                                   FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Text="{DynamicResource L10n.client.create.bedrockHint}"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                                   Margin="0,6,0,0" />
                                        <Button Content="{DynamicResource L10n.client.create.openBedrockOfficial}"
                                                Command="{Binding OpenBedrockOfficialCommand}"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Left" MinWidth="210" Margin="0,12,0,0" />
                                        <TextBlock Text="{DynamicResource L10n.client.create.bedrockHandoffHint}"
                                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}"
                                                   TextWrapping="Wrap" Margin="0,5,0,0"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding IsJavaEdition, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource ClientCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L10n.client.create.versionAndLoader}" Style="{StaticResource ClientSectionHeading}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{DynamicResource L10n.client.create.gameRelease}" Style="{StaticResource ClientFormLabel}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}"
                                                      DisplayMemberPath="Id" IsTextSearchEnabled="True" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{DynamicResource L10n.client.create.instanceName}" Style="{StaticResource ClientFormLabel}" Margin="0,0,0,5" />
                                            <TextBox Text="{Binding NewInstanceName, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource L10n.client.create.loader}" Style="{StaticResource ClientFormLabel}" />
                                    <ListBox ItemsSource="{Binding LoaderChoices}" SelectedItem="{Binding SelectedLoader}"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource LoaderListItem}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:ResponsiveWrapPanel MinItemWidth="150" ItemHeight="72"
                                                                           HorizontalSpacing="10" VerticalSpacing="10" MaximumColumns="6" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="◆" Foreground="{DynamicResource AccentBrush}" FontSize="20" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding AvailabilityText}" Style="{StaticResource MutedText}" FontSize="10" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{DynamicResource L10n.client.create.loaderVersion}" Style="{StaticResource ClientFormLabel}" />
                                    <ComboBox ItemsSource="{Binding LoaderVersions}" SelectedItem="{Binding SelectedLoaderVersion}"
                                              DisplayMemberPath="Version" />
                                    <Button Content="{DynamicResource L10n.client.action.openOfficialInstaller}" Command="{Binding OpenExternalInstallerCommand}"
                                            Visibility="{Binding IsExternalLoaderSelected, Converter={StaticResource BoolToVisibility}}"
                                            HorizontalAlignment="Left" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ClientCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L10n.client.create.memory}" Style="{StaticResource ClientSectionHeading}" />
                                    <WrapPanel Margin="0,0,0,12">
                                        <Button Content="{DynamicResource L10n.client.create.memoryGlobal}"
                                                Command="{Binding UseGlobalMemoryCommand}"
                                                Tag="{Binding IsGlobalMemory}"
                                                Style="{StaticResource ClientMemoryModeButton}" />
                                        <Button Content="{DynamicResource L10n.client.create.memoryAutomatic}"
                                                Command="{Binding UseAutomaticMemoryCommand}"
                                                Tag="{Binding IsAutomaticMemory}"
                                                Style="{StaticResource ClientMemoryModeButton}" />
                                        <Button Content="{DynamicResource L10n.client.create.memoryManual}"
                                                Command="{Binding UseManualMemoryCommand}"
                                                Tag="{Binding IsManualMemory}"
                                                Style="{StaticResource ClientMemoryModeButton}" />
                                        <TextBlock Text="{DynamicResource L10n.client.create.memoryHint}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,8" />
                                    </WrapPanel>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource L10n.client.create.memoryMinimum}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="512" Maximum="32768" TickFrequency="256"
                                                Value="{Binding MinimumMemoryMb}" Margin="10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding MinimumMemoryMb, StringFormat={}{0:N0} MB}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource L10n.client.create.memoryMaximum}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="512" Maximum="32768" TickFrequency="256"
                                                Value="{Binding MaximumMemoryMb}" Margin="10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding MaximumMemoryMb, StringFormat={}{0:N0} MB}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ClientCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L10n.client.create.gameWindow}" Style="{StaticResource ClientSectionHeading}" />
                                    <WrapPanel Margin="0,0,0,10">
                                        <Button Content="1280 × 720" Command="{Binding ApplyResolutionPresetCommand}" CommandParameter="1280x720" Margin="0,0,8,8" />
                                        <Button Content="1600 × 900" Command="{Binding ApplyResolutionPresetCommand}" CommandParameter="1600x900" Margin="0,0,8,8" />
                                        <Button Content="1920 × 1080" Command="{Binding ApplyResolutionPresetCommand}" CommandParameter="1920x1080" Margin="0,0,8,8" />
                                        <CheckBox Content="{DynamicResource L10n.client.create.fullScreen}" IsChecked="{Binding FullScreen}" VerticalAlignment="Center" Margin="10,0,0,8" />
                                    </WrapPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="{DynamicResource L10n.client.create.width}" Style="{StaticResource ClientFormLabel}" Margin="0,0,0,5" /><TextBox Text="{Binding WindowWidth}" /></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{DynamicResource L10n.client.create.height}" Style="{StaticResource ClientFormLabel}" Margin="0,0,0,5" /><TextBox Text="{Binding WindowHeight}" /></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                                        <Button Content="{DynamicResource L10n.common.cancel}" Command="{Binding CancelOperationCommand}" Margin="0,0,8,0" />
                                        <Button Content="{DynamicResource L10n.client.create.download}" Style="{StaticResource PrimaryButton}" Command="{Binding CreateInstanceCommand}" MinWidth="130" />
                                    </StackPanel>
                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="1" Value="{Binding ProgressValue, Mode=OneWay}"
                                                 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource AccentBrush}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Visibility="{Binding IsCatalogPage, Converter={StaticResource BoolToVisibility}}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="26" HorizontalAlignment="Stretch">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L10n.client.catalog.heading}" FontSize="27" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource L10n.client.catalog.description}"
                                           Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource L10n.common.close}" Command="{Binding CloseCatalogCommand}"
                                    VerticalAlignment="Center" Margin="14,0,0,0" />
                        </Grid>

                        <Border Style="{StaticResource ClientCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L10n.client.catalog.source}" Style="{StaticResource ClientSectionHeading}" />
                                                <controls:ResponsiveWrapPanel MinItemWidth="180" ItemHeight="66"
                                                           HorizontalSpacing="10" VerticalSpacing="10" MaximumColumns="3">
                                    <Button Content="Modrinth" Command="{Binding SelectCatalogSourceCommand}"
                                            CommandParameter="modrinth">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CatalogSourceId}" Value="modrinth">
                                                        <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding SelectCatalogSourceCommand}" CommandParameter="curseforge">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CatalogSourceId}" Value="curseforge">
                                                        <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <TextBlock Text="CurseForge" HorizontalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource L10n.client.catalog.apiAuthorization}" Style="{StaticResource MutedText}"
                                                       FontSize="10" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="FTB" Command="{Binding SelectCatalogSourceCommand}"
                                            CommandParameter="ftb">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CatalogSourceId}" Value="ftb">
                                                        <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </controls:ResponsiveWrapPanel>

                                <controls:ResponsiveWrapPanel Margin="0,16,0,0" MinItemWidth="155" ItemHeight="68"
                                                           HorizontalSpacing="10" VerticalSpacing="10" MaximumColumns="6"
                                                           Visibility="{Binding IsBrowsableCatalogSource, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource L10n.client.catalog.search}" Style="{StaticResource ClientFormLabel}" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding ShowsCatalogSortFilter, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{DynamicResource L10n.client.catalog.sort}" Style="{StaticResource ClientFormLabel}" Margin="0,0,0,5" />
                                        <ComboBox ItemsSource="{Binding CatalogSortOptions}" SelectedItem="{Binding SelectedCatalogSort}"
                                                  DisplayMemberPath="Name" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource L10n.client.catalog.gameVersion}" Style="{StaticResource ClientFormLabel}" Margin="0,0,0,5" />
                                        <ComboBox ItemsSource="{Binding CatalogGameVersions}" SelectedItem="{Binding SelectedCatalogGameVersion}"
                                                  DisplayMemberPath="Name" IsTextSearchEnabled="True" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource L10n.client.catalog.loader}" Style="{StaticResource ClientFormLabel}" Margin="0,0,0,5" />
                                        <ComboBox ItemsSource="{Binding CatalogLoaders}" SelectedItem="{Binding SelectedCatalogLoader}"
                                                  DisplayMemberPath="Name" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding ShowsCatalogCategoryFilter, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{DynamicResource L10n.client.catalog.category}" Style="{StaticResource ClientFormLabel}" Margin="0,0,0,5" />
                                        <ComboBox ItemsSource="{Binding CatalogCategories}" SelectedItem="{Binding SelectedCatalogCategory}"
                                                  DisplayMemberPath="Name" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource L10n.client.catalog.resultLimit}" Style="{StaticResource ClientFormLabel}" Margin="0,0,0,5" />
                                        <ComboBox ItemsSource="{Binding CatalogResultLimits}" SelectedItem="{Binding CatalogResultLimit}" />
                                    </StackPanel>
                                </controls:ResponsiveWrapPanel>

                                <Border Margin="0,14,0,0" Padding="13" CornerRadius="8"
                                        Background="{DynamicResource PanelRaisedBrush}"
                                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                        Visibility="{Binding IsUnavailableCatalogSource, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding CatalogStatusText}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding IsBrowsableCatalogSource, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource ClientCard}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CatalogResultsHeading}" Style="{StaticResource ClientSectionHeading}" Margin="0" />
                                            <TextBlock Text="{Binding CatalogResultsSummary}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{DynamicResource L10n.client.action.reloadNow}" Command="{Binding SearchCatalogCommand}" />
                                    </Grid>

                                    <ListBox Grid.Row="1" Margin="0,15,0,0" ItemsSource="{Binding CatalogProjects}"
                                             SelectedItem="{Binding SelectedCatalogProject}"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Card" Background="{DynamicResource PanelRaisedBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                                    CornerRadius="11" ClipToBounds="True">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:ResponsiveWrapPanel MinItemWidth="240" ItemHeight="324"
                                                                           HorizontalSpacing="12" VerticalSpacing="12"
                                                                           MaximumColumns="5" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="132" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border Background="{DynamicResource WindowBrush}">
                                                        <Grid>
                                                            <TextBlock Text="X" Foreground="{DynamicResource AccentBrush}"
                                                                       FontSize="35" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Image infra:LocalImageThumbnail.SourcePath="{Binding CardImagePath}"
                                                                   infra:LocalImageThumbnail.DecodePixelWidth="640"
                                                                   infra:LocalImageThumbnail.DecodePixelHeight="320"
                                                                   Stretch="UniformToFill" />
                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9"
                                                                    Background="#C912151A" CornerRadius="12" Padding="8,3">
                                                                <TextBlock Text="{Binding SourceLabel}" FontSize="10" FontWeight="Bold" />
                                                            </Border>
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9"
                                                                    Background="#C912151A" CornerRadius="12" Padding="8,3">
                                                                <TextBlock Text="{Binding GameVersionText}" FontSize="10" FontWeight="Bold" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <Grid Grid.Row="1" Margin="14,12">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Row="1" Text="{Binding AuthorText}" Style="{StaticResource MutedText}"
                                                                   FontSize="11" Margin="0,4,0,0" />
                                                        <TextBlock Grid.Row="2" Text="{Binding Description}" Style="{StaticResource MutedText}"
                                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,12,0,10" />
                                                        <Grid Grid.Row="3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding DownloadText}" Style="{StaticResource MutedText}" FontSize="10" />
                                                            <TextBlock Grid.Column="1" Text="{Binding UpdatedText}" Style="{StaticResource MutedText}" FontSize="10" />
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Button Grid.Row="2" Content="{DynamicResource L10n.client.action.loadMore}" Command="{Binding LoadMoreCatalogCommand}"
                                            IsEnabled="{Binding HasMoreCatalogResults}" HorizontalAlignment="Center"
                                            MinWidth="150" Margin="0,14,0,0"
                                            Visibility="{Binding IsModrinthCatalogSource, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource ClientCard}" Margin="0,0,0,14">
                                <controls:ResponsiveWrapPanel MinItemWidth="320" HorizontalSpacing="20"
                                                           VerticalSpacing="16" MaximumColumns="2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CatalogInstallHeading}" Style="{StaticResource ClientSectionHeading}" />
                                        <TextBlock Text="{Binding SelectedCatalogProject.Title}" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedCatalogProject.Description}" Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap" Margin="0,7,0,0" />
                                        <TextBlock Text="{Binding CatalogStatusText}" Margin="0,14,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource L10n.client.catalog.ftbInstallPolicy}"
                                                   Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding IsFtbCatalogSource, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource L10n.client.catalog.availableVersions}" Style="{StaticResource ClientFormLabel}" Margin="0,0,0,5" />
                                        <ComboBox ItemsSource="{Binding CatalogVersions}" SelectedItem="{Binding SelectedCatalogVersion}"
                                                  DisplayMemberPath="Name" />
                                        <StackPanel Visibility="{Binding ShowsModrinthInstallOptions, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{DynamicResource L10n.client.catalog.instanceName}" Style="{StaticResource ClientFormLabel}" />
                                            <TextBox Text="{Binding CatalogInstanceName, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Content="{DynamicResource L10n.client.catalog.includeOptional}" IsChecked="{Binding IncludeOptionalPackFiles}"
                                                      Margin="0,12,0,10" />
                                        </StackPanel>
                                        <Button Content="{Binding CatalogInstallActionText}" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding InstallCatalogPackCommand}" />
                                    </StackPanel>
                                </controls:ResponsiveWrapPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{Binding CatalogStatusText}" TextWrapping="Wrap" />
                                    <ProgressBar Height="7" Margin="0,10,0,0" IsIndeterminate="{Binding IsCatalogBusy}"
                                                 Minimum="0" Maximum="1" Value="{Binding ProgressValue, Mode=OneWay}" />
                                    <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}"
                                               TextWrapping="Wrap" Margin="0,7,0,0"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Visibility="{Binding IsDashboardPage, Converter={StaticResource BoolToVisibility}}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="26" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource ClientCard}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedInstance.Name}" FontSize="28" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedInstance.VersionSummary}" Style="{StaticResource MutedText}" FontSize="14" Margin="0,4,0,0" />
                                    <WrapPanel Margin="0,13,0,0">
                                        <TextBlock Text="{DynamicResource L10n.client.dashboard.playTime}" Style="{StaticResource MutedText}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding SelectedInstance.PlayTimeText}" Margin="0,0,22,0" />
                                        <TextBlock Text="{DynamicResource L10n.client.dashboard.lastPlayed}" Style="{StaticResource MutedText}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding SelectedInstance.LastPlayedText}" />
                                    </WrapPanel>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                                    <Button Content="{DynamicResource L10n.client.action.delete}" Style="{StaticResource DangerButton}" Command="{Binding DeleteClientInstanceCommand}" Margin="0,0,8,0" />
                                    <Button Content="{DynamicResource L10n.main.tab.settings}" Command="{Binding OpenClientSettingsCommand}" Margin="0,0,8,0" />
                                    <Button Content="{DynamicResource L10n.main.action.openFolder}" Command="{Binding OpenInstanceFolderCommand}" Margin="0,0,8,0" />
                                    <Button Content="{DynamicResource L10n.common.stop}" Command="{Binding StopClientCommand}" Margin="0,0,8,0" />
                                    <Button Content="{DynamicResource L10n.client.action.launch}" Style="{StaticResource PrimaryButton}" Command="{Binding LaunchCommand}" MinWidth="130" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="{DynamicResource L10n.client.content.heading}" FontSize="21" FontWeight="SemiBold" Margin="2,4,0,12" />
                        <controls:ResponsiveWrapPanel MinItemWidth="245" HorizontalSpacing="12" VerticalSpacing="12" MaximumColumns="3">
                            <Border Style="{StaticResource ClientCard}"><StackPanel><TextBlock Text="{DynamicResource L10n.client.content.mods}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource L10n.client.content.description.mods}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,16" /><Button Content="{DynamicResource L10n.client.content.openMods}" Command="{Binding OpenContentFolderCommand}" CommandParameter="mods" HorizontalAlignment="Left" /></StackPanel></Border>
                            <Border Style="{StaticResource ClientCard}"><StackPanel><TextBlock Text="{DynamicResource L10n.client.content.resourcePacks}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource L10n.client.content.description.resourcePacks}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,16" /><Button Content="{DynamicResource L10n.client.content.openResourcePacks}" Command="{Binding OpenContentFolderCommand}" CommandParameter="resourcepacks" HorizontalAlignment="Left" /></StackPanel></Border>
                            <Border Style="{StaticResource ClientCard}"><StackPanel><TextBlock Text="{DynamicResource L10n.client.content.shaderPacks}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource L10n.client.content.description.shaderPacks}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,16" /><Button Content="{DynamicResource L10n.client.content.openShaderPacks}" Command="{Binding OpenContentFolderCommand}" CommandParameter="shaderpacks" HorizontalAlignment="Left" /></StackPanel></Border>
                            <Border Style="{StaticResource ClientCard}"><StackPanel><TextBlock Text="{DynamicResource L10n.client.content.saves}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource L10n.client.content.description.saves}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,16" /><Button Content="{DynamicResource L10n.client.content.openSaves}" Command="{Binding OpenContentFolderCommand}" CommandParameter="saves" HorizontalAlignment="Left" /></StackPanel></Border>
                            <Border Style="{StaticResource ClientCard}"><StackPanel><TextBlock Text="{DynamicResource L10n.client.content.screenshots}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource L10n.client.content.description.screenshots}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,16" /><Button Content="{DynamicResource L10n.client.content.openScreenshots}" Command="{Binding OpenContentFolderCommand}" CommandParameter="screenshots" HorizontalAlignment="Left" /></StackPanel></Border>
                            <Border Style="{StaticResource ClientCard}"><StackPanel><TextBlock Text="{DynamicResource L10n.client.content.logs}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource L10n.client.content.description.logs}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,16" /><Button Content="{DynamicResource L10n.client.content.openLogs}" Command="{Binding OpenContentFolderCommand}" CommandParameter="logs" HorizontalAlignment="Left" /></StackPanel></Border>
                        </controls:ResponsiveWrapPanel>

                        <Border Style="{StaticResource ClientCard}" Margin="0,14,0,0"
                                Visibility="{Binding SelectedInstance.IsGameLogEnabled, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource L10n.client.log.heading}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource L10n.client.log.description}"
                                                   Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{DynamicResource L10n.client.action.openLogFolder}" Command="{Binding OpenContentFolderCommand}"
                                            CommandParameter="logs" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                                <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="7" Padding="8">
                                    <Grid>
                                        <TextBlock Text="{DynamicResource L10n.client.log.waiting}" Style="{StaticResource MutedText}"
                                                   Margin="4" Visibility="{Binding SelectedInstance.HasGameLogLines, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <ListBox ItemsSource="{Binding SelectedInstance.GameLogLines}" MaxHeight="260"
                                                 Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 Visibility="{Binding SelectedInstance.HasGameLogLines, Converter={StaticResource BoolToVisibility}}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="NoWrap" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ClientCard}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedContentKindText}" FontSize="19" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ContentStatusText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" Margin="14,0,0,0">
                                        <Button Content="{DynamicResource L10n.client.action.import}" Command="{Binding ImportContentCommand}" Margin="0,0,8,0"
                                                Visibility="{Binding ShowRecycleBin, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <Button Content="{DynamicResource L10n.client.vm.content.mode.recyclable}" Command="{Binding ToggleRecycleBinCommand}" Margin="0,0,8,0" />
                                        <Button Content="{DynamicResource L10n.common.refresh}" Command="{Binding RefreshContentCommand}" />
                                    </WrapPanel>
                                </Grid>
                                <WrapPanel Grid.Row="1" Margin="0,14,0,12">
                                    <Button Content="{DynamicResource L10n.client.vm.content.kind.mod}" Command="{Binding SelectContentKindCommand}" CommandParameter="Mod" Margin="0,0,8,8" />
                                    <Button Content="{DynamicResource L10n.client.vm.content.kind.resourcePack}" Command="{Binding SelectContentKindCommand}" CommandParameter="ResourcePack" Margin="0,0,8,8" />
                                    <Button Content="{DynamicResource L10n.client.vm.content.kind.shaderPack}" Command="{Binding SelectContentKindCommand}" CommandParameter="ShaderPack" Margin="0,0,8,8" />
                                    <Button Content="{DynamicResource L10n.client.vm.content.kind.save}" Command="{Binding SelectContentKindCommand}" CommandParameter="Save" Margin="0,0,8,8" />
                                    <Button Content="{DynamicResource L10n.client.vm.content.kind.screenshot}" Command="{Binding SelectContentKindCommand}" CommandParameter="Screenshot" Margin="0,0,8,8" />
                                </WrapPanel>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ListBox ItemsSource="{Binding ContentItems}" SelectedItem="{Binding SelectedContentItem}"
                                             MinHeight="160" MaxHeight="360" Background="{DynamicResource WindowBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="5">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding RelativePath}" Style="{StaticResource MutedText}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding DetailText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding StateText}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Column="1" Width="122" Margin="12,0,0,0">
                                        <Button Command="{Binding ToggleContentEnabledCommand}" Margin="0,0,0,8"
                                                Visibility="{Binding SelectedContentItem.IsActive, Converter={StaticResource BoolToVisibility}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="{DynamicResource L10n.client.action.disable}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedContentItem.IsEnabled}" Value="False"><Setter Property="Content" Value="{DynamicResource L10n.client.action.enable}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{DynamicResource L10n.client.action.recycle}" Command="{Binding RecycleContentCommand}"
                                                Visibility="{Binding SelectedContentItem.IsActive, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="{DynamicResource L10n.client.action.restore}" Style="{StaticResource PrimaryButton}" Command="{Binding RestoreContentCommand}"
                                                Visibility="{Binding SelectedContentItem.IsRecycled, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVisibility}}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="26" HorizontalAlignment="Stretch">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L10n.client.settings.heading}" FontSize="27" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource L10n.client.settings.description}"
                                           Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                                <TextBlock Text="{DynamicResource L10n.client.settings.unsavedIndicator}" Foreground="{DynamicResource WarningBrush}" Margin="0,5,0,0"
                                           Visibility="{Binding SettingsEditor.IsDirty, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="{DynamicResource L10n.common.close}" Command="{Binding CloseClientSettingsCommand}" Margin="0,0,8,0" />
                                <Button Content="{DynamicResource L10n.client.settings.apply}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveClientSettingsCommand}" MinWidth="110" />
                            </WrapPanel>
                        </Grid>

                        <Border Style="{StaticResource ClientCard}" Margin="0,0,0,14" DataContext="{Binding SettingsEditor}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L10n.client.settings.general}" Style="{StaticResource ClientSectionHeading}" />
                                <TextBlock Text="{DynamicResource L10n.client.settings.name}" Style="{StaticResource ClientFormLabel}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                <TextBlock Text="{Binding NameError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding NameError, Converter={StaticResource StringToVisibility}}" Margin="0,5,0,0" />
                                <TextBlock Text="{DynamicResource L10n.client.settings.icon}" Style="{StaticResource ClientFormLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding IconImagePath, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                    <Button Grid.Column="1" Content="{DynamicResource L10n.client.settings.chooseIcon}" Margin="8,0,0,0"
                                            Command="{Binding DataContext.ChooseClientIconCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                </Grid>
                                <TextBlock Text="{Binding IconError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding IconError, Converter={StaticResource StringToVisibility}}" Margin="0,5,0,0" />
                                <WrapPanel Margin="0,16,0,0">
                                    <CheckBox Content="{DynamicResource L10n.client.settings.quickLaunch}" IsChecked="{Binding EnableQuickLaunch}" Margin="0,0,22,8" />
                                    <CheckBox Content="{DynamicResource L10n.client.settings.hideLauncher}" IsChecked="{Binding HideLauncherAfterGameStarts}" Margin="0,0,22,8" />
                                    <CheckBox Content="{DynamicResource L10n.client.settings.showGameLog}" IsChecked="{Binding ShowGameLog}" Margin="0,0,22,8" />
                                    <CheckBox Content="{DynamicResource L10n.client.settings.preferDedicatedGpu}" IsChecked="{Binding EnableDedicatedGpu}" Margin="0,0,22,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ClientCard}" Margin="0,0,0,14" DataContext="{Binding SettingsEditor}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L10n.client.settings.resolution}" Style="{StaticResource ClientSectionHeading}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="{DynamicResource L10n.client.settings.width}" Style="{StaticResource ClientFormLabel}" Margin="0,0,0,5" /><TextBox Text="{Binding WindowWidthText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="{DynamicResource L10n.client.settings.height}" Style="{StaticResource ClientFormLabel}" Margin="0,0,0,5" /><TextBox Text="{Binding WindowHeightText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" /></StackPanel>
                                    <CheckBox Grid.Column="2" Content="{DynamicResource L10n.client.settings.fullScreen}" IsChecked="{Binding FullScreen}" Margin="18,22,0,0" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding ResolutionError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding ResolutionError, Converter={StaticResource StringToVisibility}}" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ClientCard}" Margin="0,0,0,14" DataContext="{Binding SettingsEditor}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L10n.client.settings.memory}" Style="{StaticResource ClientSectionHeading}" />
                                <TextBlock Text="{DynamicResource L10n.client.settings.configuration}" Style="{StaticResource ClientFormLabel}" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding MemoryModes}" SelectedItem="{Binding SelectedMemoryMode}"
                                          DisplayMemberPath="Name" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource L10n.client.settings.memoryMinimum}" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="512" Maximum="32768" TickFrequency="256" Value="{Binding MinimumMemoryMb}" Margin="10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding MinimumMemoryMb, StringFormat={}{0:N0} MB}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource L10n.client.settings.memoryMaximum}" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="512" Maximum="32768" TickFrequency="256" Value="{Binding MaximumMemoryMb}" Margin="10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding MaximumMemoryMb, StringFormat={}{0:N0} MB}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding MemoryError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding MemoryError, Converter={StaticResource StringToVisibility}}" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ClientCard}" Margin="0,0,0,14" DataContext="{Binding SettingsEditor}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L10n.client.settings.javaAdvanced}" Style="{StaticResource ClientSectionHeading}" />
                                <TextBlock Text="{DynamicResource L10n.client.settings.javaExecutable}" Style="{StaticResource ClientFormLabel}" Margin="0,0,0,5" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding JavaExecutablePath, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                    <Button Grid.Column="1" Content="{DynamicResource L10n.client.settings.chooseJava}" Margin="8,0,0,0"
                                            Command="{Binding DataContext.ChooseClientJavaCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                </Grid>
                                <TextBlock Text="{Binding JavaError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding JavaError, Converter={StaticResource StringToVisibility}}" Margin="0,5,0,0" />
                                <TextBlock Text="{DynamicResource L10n.client.settings.jvmArguments}" Style="{StaticResource ClientFormLabel}" />
                                <TextBox Text="{Binding JvmArgumentsText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         AcceptsReturn="True" MinHeight="130" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Cascadia Mono, Consolas" />
                                <TextBlock Text="{Binding JvmArgumentsError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding JvmArgumentsError, Converter={StaticResource StringToVisibility}}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" Margin="0,5,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{DynamicResource L10n.client.action.saveAndReturn}" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SaveClientSettingsCommand}" MinWidth="130" Margin="14,0,0,0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="X MCSV · Minecraft Client" Style="{StaticResource MutedText}"
                           FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.RowSpan="3" Panel.ZIndex="100" Background="#99000000"
                Visibility="{Binding IsClientSettingsClosePromptOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="520" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="22">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L10n.client.unsaved.heading}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource L10n.client.unsaved.description}"
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,18" />
                    <TextBlock Text="{DynamicResource L10n.client.unsaved.validation}"
                               Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Visibility="{Binding SettingsEditor.HasErrors, Converter={StaticResource BoolToVisibility}}" />
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Content="{DynamicResource L10n.common.cancel}" Command="{Binding CancelClientSettingsCloseCommand}" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource L10n.client.unsaved.discard}" Command="{Binding DiscardClientSettingsChangesCommand}" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource L10n.client.unsaved.save}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveClientSettingsCommand}" MinWidth="120" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
