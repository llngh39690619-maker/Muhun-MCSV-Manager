                                                     <TextBlock Text="{DynamicResource L10n.client.catalog.packVersion}"
                                                                Style="{StaticResource MutedText}" />
                                                     <TextBlock Grid.Column="1"
                                                                Text="{Binding SelectedCatalogVersion.PackVersionDisplay}"
                                                                TextWrapping="Wrap" />
                                                 </Grid>
                                                 <Grid Margin="0,7,0,0">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="90" />
                                                         <ColumnDefinition Width="*" />
