<UserControl x:Class="MinecraftServerManager.App.Views.ClientWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MinecraftServerManager.App.Controls"
             xmlns:infra="clr-namespace:MinecraftServerManager.App.Infrastructure"
             xmlns:dialogs="clr-namespace:MinecraftServerManager.App.Dialogs"
             xmlns:clientContracts="clr-namespace:MinecraftServerManager.GameClient.Contracts;assembly=MinecraftServerManager.GameClient.Contracts"
             Background="Transparent"
             Foreground="{DynamicResource TextBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="ClientCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="ClientModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="102" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="ClientMemoryModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClientContentActionButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
        <Style x:Key="ClientContentPrimaryActionButton" TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
        <Style x:Key="ClientSectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="ClientDashboardTabButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="ClientHeroSecondaryButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,7,7" />
        </Style>
        <Style x:Key="ClientCatalogSidebarNavButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClientFormLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Margin" Value="0,12,0,5" />
        </Style>
        <Style x:Key="LoaderListItem" TargetType="ListBoxItem">
            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="LoaderBorder"
                                Background="{DynamicResource PanelRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="13">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LoaderBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="LoaderBorder" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                <Setter TargetName="LoaderBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="LoaderBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="ClientWorkspaceHeaderBrand" Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Width" Value="184" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCatalogPage}" Value="True">
                                    <Setter Property="Width" Value="228" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="X" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="11" />
                    <TextBlock Text="X MCSV" FontWeight="SemiBold" FontSize="21" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource L10n.main.workspace.server}" Style="{StaticResource ClientModeButton}"
                            Command="{Binding DataContext.ShowServerWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    <Button Content="{DynamicResource L10n.main.workspace.client}" Style="{StaticResource PrimaryButton}" MinWidth="102" Margin="0,0,8,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleAccountPanelCommand}" Width="42" MinWidth="42" Height="42"
                            Margin="0,0,6,0" Padding="4" ToolTip="{Binding AccountButtonAccessibleName}"
                            AutomationProperties.Name="{Binding AccountButtonAccessibleName}">
                        <Border Width="32" Height="32" CornerRadius="4" Background="{DynamicResource AccentDarkBrush}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource MutedTextBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Top" />
                                    <Ellipse Width="15" Height="8" Fill="{DynamicResource MutedTextBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                </Grid>
                                <Image Source="{Binding SelectedPlayerHeadTexture}" Width="32" Height="32" Stretch="Fill"
                                       SnapsToDevicePixels="True" UseLayoutRounding="True"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Grid>
                        </Border>
                    </Button>
                    <ComboBox x:Name="HeaderAccountSelector"
                              ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                              DisplayMemberPath="Username" Width="176" Height="42" Margin="0,0,6,0"
                              Padding="10,0,34,0" FontSize="15" FontWeight="Medium"
                              VerticalContentAlignment="Center"
                              ToolTip="{DynamicResource L10n.client.account.select}"
                              AutomationProperties.Name="{DynamicResource L10n.client.account.select}" />
                    <Button Content="{DynamicResource L10n.client.account.add}" Command="{Binding AddAccountCommand}"
                            Height="38" MinWidth="0" Padding="10,6" Margin="0,0,6,0"
                            AutomationProperties.Name="{DynamicResource L10n.client.account.add}" />
                    <Button Content="{DynamicResource L10n.common.refresh}" Command="{Binding RefreshCatalogCommand}"
                            Height="38" MinWidth="0" Padding="10,6" Margin="0,0,6,0" />
                    <Button Content="⚙" Width="42" MinWidth="42" Padding="4"
                            Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ClientWorkspaceNavigation" Grid.Column="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="202" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCatalogPage}" Value="True">
                                <Setter Property="Width" Value="246" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding IsCatalogPage, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="X MCSV" FontSize="22" FontWeight="SemiBold" Margin="10,0,0,18" />
                        <Button Content="{DynamicResource L10n.client.launcher.nav.home}"
                                Command="{Binding OpenDashboardCommand}" Height="44"
                                HorizontalContentAlignment="Left" Padding="16,8" Margin="0,0,0,8" />
                        <Button Content="{DynamicResource L10n.client.launcher.nav.client}"
                                Style="{StaticResource PrimaryButton}" Command="{Binding OpenDashboardCommand}" Height="46"
                                HorizontalContentAlignment="Left" Padding="16,8" Margin="0,0,0,8" />
                        <Button Content="{DynamicResource L10n.client.launcher.nav.downloads}"
                                Command="{Binding ToggleCatalogInstallSidebarCommand}" Height="44"
                                HorizontalContentAlignment="Left" Padding="16,8" Margin="0,0,0,8" />
                        <Button Content="{DynamicResource L10n.client.launcher.nav.settings}"
                                Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                Height="44" HorizontalContentAlignment="Left" Padding="16,8" />
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                             Visibility="Collapsed"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="InstanceBorder" Background="{DynamicResource PanelRaisedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="9" Padding="10">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="InstanceBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="InstanceBorder" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                                    <Setter TargetName="InstanceBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="34" Height="34" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource WindowBrush}" CornerRadius="7">
                                            <TextBlock Text="▣" Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" />
                                        </Border>
                                        <Grid Visibility="{Binding UsesGrassBlockFallback, Converter={StaticResource BoolToVisibility}}">
                                            <Border Background="#795238" CornerRadius="7" />
                                            <Border Height="11" VerticalAlignment="Top" Background="#62A83E" CornerRadius="7,7,2,2" />
                                            <Rectangle Width="5" Height="7" Fill="#8A6543" Margin="5,12,0,0"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <Rectangle Width="6" Height="5" Fill="#63432F" Margin="0,0,5,5"
                                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        </Grid>
                                        <Border Background="{DynamicResource WindowBrush}" CornerRadius="7"
                                                Visibility="{Binding CatalogSourceBadgeText, Converter={StaticResource StringToVisibility}}">
                                            <TextBlock Text="{Binding CatalogSourceBadgeText}" Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="11" FontWeight="Bold" />
                                        </Border>
                                        <Image infra:LocalImageThumbnail.SourcePath="{Binding IconImagePath}"
                                               infra:LocalImageThumbnail.DecodePixelWidth="96"
                                               infra:LocalImageThumbnail.DecodePixelHeight="96"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding VersionSummary}" Style="{StaticResource MutedText}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                                        <Button Content="▶" ToolTip="{DynamicResource L10n.client.quickLaunch}" Width="30" MinWidth="30" Height="26" Padding="3"
                                                Margin="0,5,0,0" Visibility="{Binding CanQuickLaunch, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.QuickLaunchCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0"
                                Visibility="{Binding IsCatalogPage, Converter={StaticResource InverseBoolToVisibility}}">
                        <Button Content="{DynamicResource L10n.client.action.create}"
                                Command="{Binding NewInstanceCommand}" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,0,10"
                                Visibility="{Binding HasSelectedInstance, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Visibility="{Binding HasBedrockShortcuts, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource L10n.client.bedrock.shortcuts.heading}"
                                       FontWeight="SemiBold" Margin="4,0,4,7" />
                            <ListBox ItemsSource="{Binding BedrockShortcuts}"
                                     SelectedItem="{Binding SelectedBedrockShortcut}"
                                     MaxHeight="190" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,7" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ShortcutBorder"
                                                            Background="{DynamicResource PanelRaisedBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="9" Padding="10">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ShortcutBorder" Property="BorderBrush"
                                                                    Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ShortcutBorder" Property="Background"
                                                                    Value="{DynamicResource AccentDarkBrush}" />
                                                            <Setter TargetName="ShortcutBorder" Property="BorderBrush"
                                                                    Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="34" Height="34" VerticalAlignment="Center">
                                                <Border Background="#795238" CornerRadius="7" />
                                                <Border Height="11" VerticalAlignment="Top" Background="#62A83E"
                                                        CornerRadius="7,7,2,2" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding VersionSummary}"
                                                           Style="{StaticResource MutedText}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer x:Name="CatalogDiscoveryNavigation" Grid.RowSpan="3"
                                  Visibility="{Binding IsCatalogPage, Converter={StaticResource BoolToVisibility}}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="2,7,2,10">
                            <Grid Margin="4,0,4,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource L10n.client.instances.heading}"
                                           FontSize="17" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Instances.Count}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{DynamicResource L10n.client.instances.countSuffix}"
                                               Style="{StaticResource MutedText}" />
                                </StackPanel>
                            </Grid>

                            <ListBox x:Name="CatalogDiscoveryInstanceList"
                                     ItemsSource="{Binding Instances}"
                                     SelectedItem="{Binding SelectedInstance}"
                                     PreviewMouseLeftButtonDown="OnCatalogDiscoveryInstancePreviewMouseLeftButtonDown"
                                     MaxHeight="180" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,7" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="CatalogInstanceCard"
                                                            Background="{DynamicResource PanelRaisedBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="8" Padding="9">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CatalogInstanceCard" Property="BorderBrush"
                                                                    Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="CatalogInstanceCard" Property="Background"
                                                                    Value="{DynamicResource AccentDarkBrush}" />
                                                            <Setter TargetName="CatalogInstanceCard" Property="BorderBrush"
                                                                    Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="38" Height="38" VerticalAlignment="Center">
                                                <Border Background="#795238" CornerRadius="6" />
                                                <Border Height="11" VerticalAlignment="Top"
                                                        Background="#62A83E" CornerRadius="6,6,1,1" />
                                                <Border Background="{DynamicResource WindowBrush}" CornerRadius="6"
                                                        Visibility="{Binding CatalogSourceBadgeText, Converter={StaticResource StringToVisibility}}">
                                                    <TextBlock Text="{Binding CatalogSourceBadgeText}"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontSize="11" FontWeight="Bold" />
                                                </Border>
                                                <Image infra:LocalImageThumbnail.SourcePath="{Binding IconImagePath}"
                                                       infra:LocalImageThumbnail.DecodePixelWidth="96"
                                                       infra:LocalImageThumbnail.DecodePixelHeight="96"
                                                       Stretch="UniformToFill" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding VersionSummary}"
                                                           Style="{StaticResource MutedText}" FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <Ellipse Width="8" Height="8" HorizontalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}"
                                                                             Value="{x:Static clientContracts:MinecraftClientInstanceState.Ready}">
                                                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}"
                                                                             Value="{x:Static clientContracts:MinecraftClientInstanceState.Running}">
                                                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}"
                                                                             Value="{x:Static clientContracts:MinecraftClientInstanceState.Failed}">
                                                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}"
                                                           FontSize="8" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button Content="{DynamicResource L10n.client.action.create}"
                                    Command="{Binding NewInstanceCommand}"
                                    HorizontalAlignment="Stretch" Margin="0,2,0,14" />

                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0" Padding="4,13,4,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L10n.client.launcher.sidebar.contentDiscovery}"
                                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Button Command="{Binding OpenCatalogCommand}"
                                            Style="{StaticResource ClientCatalogSidebarNavButton}"
                                            Tag="{Binding IsModpackCatalogPage}"
                                            HorizontalContentAlignment="Left" Padding="14,8"
                                            Margin="0,0,0,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🎮" Width="28" FontFamily="Segoe UI Emoji" />
                                            <TextBlock Text="{DynamicResource L10n.client.launcher.tab.modpacks}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ClientCatalogSidebarNavButton}"
                                            Command="{Binding OpenContentDownloadCommand}"
                                            Tag="{Binding IsModContentDownloadPage}"
                                            CommandParameter="{x:Static clientContracts:MinecraftClientContentKind.Mod}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✣" Width="28" FontFamily="Segoe UI Symbol" FontSize="16" />
                                            <TextBlock Text="{DynamicResource L10n.client.launcher.tab.mods}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ClientCatalogSidebarNavButton}"
                                            Command="{Binding OpenContentDownloadCommand}"
                                            Tag="{Binding IsResourcePackContentDownloadPage}"
                                            CommandParameter="{x:Static clientContracts:MinecraftClientContentKind.ResourcePack}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▧" Width="28" FontFamily="Segoe UI Symbol" FontSize="16" />
                                            <TextBlock Text="{DynamicResource L10n.client.launcher.tab.resourcePacks}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ClientCatalogSidebarNavButton}"
                                            Command="{Binding OpenContentDownloadCommand}"
                                            Tag="{Binding IsShaderPackContentDownloadPage}"
                                            CommandParameter="{x:Static clientContracts:MinecraftClientContentKind.ShaderPack}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="☀" Width="28" FontFamily="Segoe UI Symbol" FontSize="16" />
                                            <TextBlock Text="{DynamicResource L10n.client.launcher.tab.shaderPacks}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ClientCatalogSidebarNavButton}"
                                            Command="{Binding BrowseAllCatalogCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⌘" Width="28" FontFamily="Segoe UI Symbol" FontSize="16" />
                                            <TextBlock Text="{DynamicResource L10n.client.launcher.sidebar.browseAll}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0" Padding="4,13,4,0" Margin="0,13,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L10n.client.launcher.sidebar.utilities}"
                                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Button Style="{StaticResource ClientCatalogSidebarNavButton}"
                                            Command="{Binding OpenClientJavaSettingsCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="☕" Width="28" FontFamily="Segoe UI Symbol" FontSize="16" />
                                            <TextBlock Text="{DynamicResource L10n.client.launcher.tab.java}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ClientCatalogSidebarNavButton}"
                                            Command="{Binding OpenClientSettingsCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚙" Width="28" FontFamily="Segoe UI Symbol" FontSize="16" />
                                            <TextBlock Text="{DynamicResource L10n.client.launcher.tab.settings}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ClientCatalogSidebarNavButton}"
                                            Command="{Binding ToggleDiscoveryDownloadQueueCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="↓" Width="28" FontFamily="Segoe UI Symbol" FontSize="18" />
                                            <TextBlock Text="{DynamicResource L10n.client.launcher.tab.downloads}" />
                                            <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="9"
                                                    Padding="6,1" Margin="8,0,0,0"
                                                    Visibility="{Binding HasDiscoveryDownloadJobs, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding DiscoveryDownloadJobCount}" FontSize="10" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid x:Name="CreatePageLayout"
                      Visibility="{Binding IsCreatePage, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="CreateFormScrollViewer" Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="26,26,26,14" HorizontalAlignment="Stretch">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L10n.client.create.heading}" FontSize="27" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource L10n.client.create.description}"
                                           Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource L10n.common.close}" Command="{Binding CloseCreateCommand}" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource ClientCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L10n.client.create.mode}" Style="{StaticResource ClientSectionHeading}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{DynamicResource L10n.client.create.javaEdition}" Command="{Binding SelectJavaEditionCommand}" MinWidth="130" Margin="0,0,8,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers><DataTrigger Binding="{Binding IsJavaEdition}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{DynamicResource L10n.client.create.bedrockEdition}" Command="{Binding SelectBedrockEditionCommand}" MinWidth="130">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers><DataTrigger Binding="{Binding IsBedrockEdition}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                                <Border Visibility="{Binding IsBedrockEdition, Converter={StaticResource BoolToVisibility}}"
                                        Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource WarningBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource L10n.client.create.bedrockOfficialHeading}"
                                                   FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Text="{DynamicResource L10n.client.create.bedrockHint}"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                                   Margin="0,6,0,0" />
                                        <TextBlock Text="{DynamicResource L10n.client.create.bedrockAliasLabel}"
                                                   Style="{StaticResource ClientFormLabel}" Margin="0,14,0,5" />
                                        <TextBox Text="{Binding NewBedrockShortcutName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{DynamicResource L10n.client.create.bedrockAliasDescription}"
                                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        <TextBlock Text="{DynamicResource L10n.client.create.bedrockChannel}"
                                                   Style="{StaticResource ClientFormLabel}" Margin="0,14,0,5" />
                                        <ComboBox ItemsSource="{Binding BedrockChannelChoices}"
                                                  SelectedItem="{Binding SelectedBedrockChannel}"
                                                  DisplayMemberPath="Name" />
                                        <TextBlock Text="{DynamicResource L10n.client.create.bedrockChannelHint}"
                                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        <Button Content="{DynamicResource L10n.client.create.openBedrockOfficial}"
                                                Command="{Binding OpenBedrockOfficialCommand}"
                                                HorizontalAlignment="Left" MinWidth="210" Margin="0,12,0,0" />
                                        <TextBlock Text="{DynamicResource L10n.client.create.bedrockHandoffHint}"
                                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}"
                                                   TextWrapping="Wrap" Margin="0,5,0,0"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding IsJavaEdition, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource ClientCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L10n.client.create.versionAndLoader}" Style="{StaticResource ClientSectionHeading}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{DynamicResource L10n.client.create.gameRelease}" Style="{StaticResource ClientFormLabel}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}"
                                                      DisplayMemberPath="Id" IsTextSearchEnabled="True" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{DynamicResource L10n.client.create.instanceName}" Style="{StaticResource ClientFormLabel}" Margin="0,0,0,5" />
                                            <TextBox Text="{Binding NewInstanceName, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource L10n.client.create.loader}" Style="{StaticResource ClientFormLabel}" />
                                    <ListBox ItemsSource="{Binding LoaderChoices}" SelectedItem="{Binding SelectedLoader}"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource LoaderListItem}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:ResponsiveWrapPanel MinItemWidth="150" ItemHeight="72"
                                                                           HorizontalSpacing="10" VerticalSpacing="10" MaximumColumns="6" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="◆" Foreground="{DynamicResource AccentBrush}" FontSize="20" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding AvailabilityText}" Style="{StaticResource MutedText}" FontSize="10" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{DynamicResource L10n.client.create.loaderVersion}" Style="{StaticResource ClientFormLabel}" />
                                    <ComboBox ItemsSource="{Binding LoaderVersions}" SelectedItem="{Binding SelectedLoaderVersion}"
                                              DisplayMemberPath="Version" />
                                    <Button Content="{DynamicResource L10n.client.action.openOfficialInstaller}" Command="{Binding OpenExternalInstallerCommand}"
                                            Visibility="{Binding IsExternalLoaderSelected, Converter={StaticResource BoolToVisibility}}"
                                            HorizontalAlignment="Left" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ClientCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L10n.client.create.memory}" Style="{StaticResource ClientSectionHeading}" />
                                    <WrapPanel Margin="0,0,0,12">
                                        <Button Content="{DynamicResource L10n.client.create.memoryGlobal}"
                                                Command="{Binding UseGlobalMemoryCommand}"
                                                Tag="{Binding IsGlobalMemory}"
                                                Style="{StaticResource ClientMemoryModeButton}" />
                                        <Button Content="{DynamicResource L10n.client.create.memoryAutomatic}"
                                                Command="{Binding UseAutomaticMemoryCommand}"
                                                Tag="{Binding IsAutomaticMemory}"
                                                Style="{StaticResource ClientMemoryModeButton}" />
                                        <Button Content="{DynamicResource L10n.client.create.memoryManual}"
                                                Command="{Binding UseManualMemoryCommand}"
                                                Tag="{Binding IsManualMemory}"
                                                Style="{StaticResource ClientMemoryModeButton}" />
                                        <TextBlock Text="{DynamicResource L10n.client.create.memoryHint}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,8" />
                                    </WrapPanel>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource L10n.client.create.memoryMinimum}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="512" Maximum="32768" TickFrequency="256"
                                                Value="{Binding MinimumMemoryMb}" Margin="10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding MinimumMemoryMb, StringFormat={}{0:N0} MB}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource L10n.client.create.memoryMaximum}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="512" Maximum="32768" TickFrequency="256"
                                                Value="{Binding MaximumMemoryMb}" Margin="10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding MaximumMemoryMb, StringFormat={}{0:N0} MB}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ClientCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L10n.client.create.gameWindow}" Style="{StaticResource ClientSectionHeading}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding ResolutionChoices}" SelectedItem="{Binding SelectedResolution}"
                                                  DisplayMemberPath="DisplayName" MinWidth="220" />
                                        <CheckBox Grid.Column="1" Content="{DynamicResource L10n.client.create.fullScreen}"
                                                  IsChecked="{Binding FullScreen}" VerticalAlignment="Center" Margin="18,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="CreateActionBar" Grid.Row="1"
                            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,1,1,0" CornerRadius="10,10,0,0"
                            Padding="14" Margin="26,0,26,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" Margin="0,5,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="{DynamicResource L10n.common.cancel}" Command="{Binding CancelOperationCommand}" Margin="0,0,8,0" />
                                <Button Content="{DynamicResource L10n.client.create.download}" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding CreateInstanceCommand}" MinWidth="130"
                                        Visibility="{Binding IsJavaEdition, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="{DynamicResource L10n.client.create.bedrockCreate}" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding CreateInstanceCommand}" MinWidth="230"
                                        Visibility="{Binding IsBedrockEdition, Converter={StaticResource BoolToVisibility}}" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <ProgressBar x:Name="CreateInstallProgressBar" Grid.Row="2"
                                 Height="8" Margin="26,0,26,14"
                                 Minimum="0" Maximum="1" Value="{Binding ProgressValue, Mode=OneWay}"
                                  Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource AccentBrush}"
                                  AutomationProperties.Name="{Binding StatusText}"
                                  Visibility="{Binding IsJavaEdition, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Grid x:Name="CatalogPageLayout"
                      Visibility="{Binding IsModpackCatalogPage, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="CatalogDiscoveryBody" Grid.Row="0" Margin="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="356" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer x:Name="CatalogPageScrollViewer" Grid.Column="0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border x:Name="CatalogDiscoveryFilters"
                                        Style="{StaticResource ClientCard}" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="138" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     MinHeight="38" Padding="12,7"
                                                     VerticalAlignment="Bottom"
                                                     AutomationProperties.Name="{DynamicResource L10n.client.catalog.search}" />
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0"
                                                        Visibility="{Binding ShowsCatalogCategoryFilter, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{DynamicResource L10n.client.catalog.category}"
                                                           Style="{StaticResource ClientFormLabel}" Margin="0,0,0,3" FontSize="10" />
                                                <ComboBox ItemsSource="{Binding CatalogCategories}"
                                                          SelectedItem="{Binding SelectedCatalogCategory}"
                                                          DisplayMemberPath="Name" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                                <TextBlock Text="{DynamicResource L10n.client.catalog.resultLimit}"
                                                           Style="{StaticResource ClientFormLabel}" Margin="0,0,0,3" FontSize="10" />
                                                <ComboBox ItemsSource="{Binding CatalogResultLimits}"
                                                          SelectedItem="{Binding CatalogResultLimit}" />
                                            </StackPanel>
                                             <Button x:Name="CatalogSearchButton" Grid.Column="3"
                                                     Content="{DynamicResource L10n.client.catalog.search}"
                                                     Command="{Binding SearchCatalogCommand}"
                                                     Style="{StaticResource PrimaryButton}" MinWidth="100"
                                                     VerticalAlignment="Bottom" Margin="8,0,0,0" />
                                        </Grid>

                                        <controls:ResponsiveToolbarPanel x:Name="CatalogSourceAndFilters" Margin="0,9,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="106" />
                                                    <ColumnDefinition Width="66" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource L10n.client.catalog.source}"
                                                           Style="{StaticResource ClientFormLabel}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Button Grid.Column="1" Content="Modrinth" Height="42"
                                                        Command="{Binding SelectCatalogSourceCommand}"
                                                        CommandParameter="modrinth" Margin="0,0,7,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CatalogSourceId}" Value="modrinth">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Grid.Column="2" Height="42" Command="{Binding SelectCatalogSourceCommand}"
                                                        CommandParameter="curseforge" Margin="0,0,7,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CatalogSourceId}" Value="curseforge">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="CurseForge" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{DynamicResource L10n.client.catalog.apiAuthorization}"
                                                                   Style="{StaticResource MutedText}" FontSize="8"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="3" Content="FTB" Height="42"
                                                        Command="{Binding SelectCatalogSourceCommand}" CommandParameter="ftb">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CatalogSourceId}" Value="ftb">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                            </Grid>
                                            <StackPanel x:Name="CatalogGameVersionFilter" Width="150">
                                                <TextBlock Text="{DynamicResource L10n.client.catalog.gameVersion}"
                                                           Style="{StaticResource ClientFormLabel}" Margin="0,0,0,3" FontSize="10" />
                                                <ComboBox ItemsSource="{Binding CatalogGameVersions}"
                                                          SelectedItem="{Binding SelectedCatalogGameVersion}"
                                                          DisplayMemberPath="Name" IsTextSearchEnabled="True" />
                                            </StackPanel>
                                            <StackPanel x:Name="CatalogLoaderFilter" Width="150">
                                                <TextBlock Text="{DynamicResource L10n.client.catalog.loader}"
                                                           Style="{StaticResource ClientFormLabel}" Margin="0,0,0,3" FontSize="10" />
                                                <ComboBox ItemsSource="{Binding CatalogLoaders}"
                                                          SelectedItem="{Binding SelectedCatalogLoader}"
                                                          DisplayMemberPath="Name" />
                                            </StackPanel>
                                            <StackPanel x:Name="CatalogSortFilter" Width="174"
                                                        Visibility="{Binding ShowsCatalogSortFilter, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{DynamicResource L10n.client.catalog.sort}"
                                                           Style="{StaticResource ClientFormLabel}" Margin="0,0,0,3" FontSize="10" />
                                                <ComboBox ItemsSource="{Binding CatalogSortOptions}"
                                                          SelectedItem="{Binding SelectedCatalogSort}"
                                                          DisplayMemberPath="Name" />
                                            </StackPanel>
                                        </controls:ResponsiveToolbarPanel>

                                        <Border Margin="0,10,0,0" Padding="10" CornerRadius="8"
                                                Background="{DynamicResource PanelRaisedBrush}"
                                                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                                Visibility="{Binding IsUnavailableCatalogSource, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding CatalogStatusText}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource WarningBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="CatalogDiscoveryResultsPanel"
                                        Style="{StaticResource ClientCard}" Padding="12"
                                        Visibility="{Binding IsBrowsableCatalogSource, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding CatalogResultsHeading}"
                                                           Style="{StaticResource ClientSectionHeading}" Margin="0" />
                                                <TextBlock Text="{Binding CatalogResultsSummary}"
                                                           Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{DynamicResource L10n.client.action.reloadNow}"
                                                    Command="{Binding SearchCatalogCommand}" />
                                        </Grid>

                                        <ListBox x:Name="CatalogResultsList" Grid.Row="1" Margin="0,11,0,0"
                                                 ItemsSource="{Binding CatalogProjects}"
                                                 SelectedItem="{Binding SelectedCatalogProject}"
                                                 Background="Transparent" BorderThickness="0">
                                            <ListBox.Template>
                                                <!-- CatalogPageScrollViewer owns vertical motion so the wheel works
                                                     over images, text, cards, and empty space alike. -->
                                                <ControlTemplate TargetType="{x:Type ListBox}">
                                                    <ItemsPresenter />
                                                </ControlTemplate>
                                            </ListBox.Template>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Card"
                                                                        Background="{DynamicResource PanelRaisedBrush}"
                                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                                        BorderThickness="1" CornerRadius="9"
                                                                        ClipToBounds="True">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Card" Property="BorderBrush"
                                                                                Value="{DynamicResource AccentBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Card" Property="BorderBrush"
                                                                                Value="{DynamicResource AccentBrush}" />
                                                                        <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
