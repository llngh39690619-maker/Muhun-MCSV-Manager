<Window x:Class="MinecraftServerManager.App.Dialogs.ProductServiceRemoteAccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MinecraftServerManager.App.Controls"
        Title="{DynamicResource L10n.remote.window.title}"
        Width="1120" Height="820" MinWidth="860" MinHeight="650"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        Loaded="OnLoaded" Deactivated="OnDeactivated" Closing="OnClosing">
    <Grid Background="{DynamicResource WindowBrush}" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource L10n.remote.heading}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Text="{DynamicResource L10n.remote.service.description}" />
            </StackPanel>
            <Button Grid.Column="1" Content="{DynamicResource L10n.common.refresh}" Command="{Binding RefreshCommand}"
                    VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>

        <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True" Margin="0,0,0,8"
                     Foreground="{DynamicResource AccentBrush}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <TabControl Grid.Row="2" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
            <TabItem Header="{DynamicResource L10n.remote.connectionStatus}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,8,0">
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L10n.remote.service.lifecycle}" FontSize="18" FontWeight="SemiBold" />
                                <WrapPanel Margin="0,14,0,4">
                                    <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="14" Padding="12,7" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource L10n.remote.service.configuration}" />
                                            <TextBlock Text="{Binding DesiredStateText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="14" Padding="12,7" Margin="0,0,8,8">
                                        <TextBlock Text="{Binding HostStateText}" />
                                    </Border>
                                    <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="14" Padding="12,7" Margin="0,0,8,8">
                                        <TextBlock Text="{Binding FunnelStateText}" />
                                    </Border>
                                    <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="14" Padding="12,7" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource L10n.remote.connectionStatus}" />
                                            <TextBlock Text="{Binding ConnectionStateText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{DynamicResource L10n.remote.service.publicUrl}" Style="{StaticResource MutedText}" Margin="0,12,0,5" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding PublicUrl, Mode=OneWay}" IsReadOnly="True"
                                             FontFamily="Cascadia Mono, Consolas" />
                                    <Button Grid.Column="1" Content="{DynamicResource L10n.remote.copyUrl}" Command="{Binding CopyUrlCommand}" Margin="8,0,0,0" />
                                    <Button Grid.Column="2" Content="{DynamicResource L10n.common.open}" Command="{Binding OpenUrlCommand}" Margin="8,0,0,0"
                                            Style="{StaticResource PrimaryButton}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="{DynamicResource L10n.remote.service.lastUpdated}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding LastUpdatedText, Mode=OneWay}"
                                               Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <TextBlock Text="{Binding RetryText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                <WrapPanel Margin="0,18,0,0">
                                    <Button Content="{DynamicResource L10n.remote.service.enableWeb}" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" />
                                    <Button Content="{DynamicResource L10n.common.reconnect}" Command="{Binding ReconnectCommand}" Margin="8,0,0,0" />
                                    <Button Content="{DynamicResource L10n.remote.closeWeb}" Command="{Binding StopCommand}" Margin="8,0,0,0"
                                            Style="{StaticResource DangerButton}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#33204A36" BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                            <TextBlock TextWrapping="Wrap"
                                       Text="{DynamicResource L10n.remote.service.securityBoundary}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource L10n.remote.accounts}">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource L10n.remote.addAccount}" FontWeight="SemiBold" />
                                <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" MaxLength="32"
                                         Margin="0,6,0,0" AutomationProperties.Name="{DynamicResource L10n.remote.username}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource L10n.remote.service.emailOptional}" Style="{StaticResource MutedText}" />
                                <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" MaxLength="254"
                                         Margin="0,6,0,0" AutomationProperties.Name="{DynamicResource L10n.remote.service.emailOptional}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{DynamicResource L10n.remote.pin}" Style="{StaticResource MutedText}" />
                                <controls:RevealPasswordBox Password="{Binding NewPin, UpdateSourceTrigger=PropertyChanged}"
                                                            MaxLength="12" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="{DynamicResource L10n.remote.confirmPin}" Style="{StaticResource MutedText}" />
                                <controls:RevealPasswordBox Password="{Binding ConfirmedNewPin, UpdateSourceTrigger=PropertyChanged}"
                                                            MaxLength="12" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="7" Margin="12,0,0,0">
                                <TextBlock Text="{DynamicResource L10n.remote.service.role}" Style="{StaticResource MutedText}" />
                                <ComboBox ItemsSource="{Binding AvailableRoles}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Role"
                                          SelectedValue="{Binding NewRole}"
                                          Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="8" Margin="12,0,0,0" VerticalAlignment="Bottom">
                                <CheckBox Content="{DynamicResource L10n.remote.service.initialFullPermission}" IsChecked="{Binding GrantAllToNewAccount}"
                                          Margin="0,0,0,6" ToolTip="{DynamicResource L10n.remote.service.initialFullPermissionHint}" />
                                <Button Content="{DynamicResource L10n.remote.createAccount}" Command="{Binding CreateAccountCommand}"
                                        Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="270" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="8">
                            <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                     Style="{StaticResource ThemedListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="10,8">
                                            <TextBlock Text="{Binding Username}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding IdentityText}" Style="{StaticResource MutedText}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding RoleDisplayText}" Style="{StaticResource MutedText}" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{DynamicResource L10n.remote.service.accountEnabled}" Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding Enabled, Mode=OneWay}"
                                                           Style="{StaticResource MutedText}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedAccountNameText}"
                                                       FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedAccount.LockoutText}" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource L10n.remote.service.role}" Style="{StaticResource MutedText}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox Width="130"
                                                      ItemsSource="{Binding DataContext.AvailableRoles, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Role"
                                                      SelectedValue="{Binding SelectedAccount.Role}" />
                                            <CheckBox Content="{DynamicResource L10n.remote.service.allowSignIn}"
                                                      IsChecked="{Binding SelectedAccount.Enabled}"
                                                      Margin="14,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource L10n.remote.service.currentPin}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedAccount.PinDisplayText, Mode=OneWay}" IsReadOnly="True"
                                                 Margin="8,0,0,0" FontFamily="Cascadia Mono, Consolas" />
                                        <Button Grid.Column="2" Content="{Binding SelectedAccount.PinToggleText}"
                                                Command="{Binding TogglePinVisibilityCommand}" Margin="8,0,0,0" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0">
                                            <controls:RevealPasswordBox Width="160" Password="{Binding SelectedAccount.NewPin, UpdateSourceTrigger=PropertyChanged}"
                                                                        MaxLength="12" />
                                            <controls:RevealPasswordBox Width="160" Margin="8,0,0,0"
                                                                        Password="{Binding SelectedAccount.ConfirmedNewPin, UpdateSourceTrigger=PropertyChanged}"
                                                                        MaxLength="12" />
                                        </StackPanel>
                                        <Button Grid.Column="4" Content="{DynamicResource L10n.remote.service.resetPin}" Command="{Binding ResetPinCommand}" Margin="8,0,0,0" />
                                    </Grid>
                                    <WrapPanel Margin="0,12,0,10">
                                        <Button Content="{DynamicResource L10n.remote.service.grantAll}" Command="{Binding GrantAllCommand}" />
                                        <Button Content="{DynamicResource L10n.remote.service.clearAll}" Command="{Binding ClearPermissionsCommand}" Margin="8,0,0,0" />
                                        <Button Content="{DynamicResource L10n.remote.service.saveAuthorization}" Command="{Binding SaveAuthorizationCommand}"
                                                Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                                        <Button Content="{DynamicResource L10n.remote.service.deleteAccount}" Command="{Binding DeleteAccountCommand}"
                                                Style="{StaticResource DangerButton}" Margin="8,0,0,0" />
                                    </WrapPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="{DynamicResource L10n.remote.service.allPermissions}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SelectedAccount.Permissions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="230" />
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Code}" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{DynamicResource L10n.remote.service.category}" Style="{StaticResource MutedText}" />
                                                                <TextBlock Text="{Binding Category, Mode=OneWay}"
                                                                           Style="{StaticResource MutedText}" />
                                                                <TextBlock Text="{DynamicResource L10n.remote.service.highRisk}" Style="{StaticResource MutedText}" />
                                                                <TextBlock Text="{Binding IsHighRisk, Mode=OneWay}"
                                                                           Style="{StaticResource MutedText}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" Content="{DynamicResource L10n.remote.service.globalGrant}" IsChecked="{Binding IsGlobalGranted}"
                                                                  VerticalAlignment="Center" />
                                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Servers}"
                                                                      Visibility="{Binding SupportsServerScope, Converter={StaticResource BoolToVisibility}}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsGranted}"
                                                                              Margin="0,2,14,2" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource L10n.remote.service.devices}">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource L10n.remote.service.devicesHint}" Style="{StaticResource MutedText}" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                             Style="{StaticResource ThemedListBoxStyle}" Margin="0,12,0,12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Username}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Label}" />
                                        <TextBlock Text="{Binding DeviceId}" Style="{StaticResource MutedText}" FontFamily="Cascadia Mono, Consolas" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource L10n.remote.service.lastUsed}" Style="{StaticResource MutedText}" />
                                        <TextBlock Text="{Binding LastUsedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="{DynamicResource L10n.remote.service.idleExpiry}" Style="{StaticResource MutedText}" />
                                        <TextBlock Text="{Binding IdleExpiresAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" Content="{DynamicResource L10n.remote.service.revokeDevice}" Command="{Binding RevokeDeviceCommand}"
                            Style="{StaticResource DangerButton}" HorizontalAlignment="Right" />
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,12,0">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
            <Button Grid.Column="1" Content="{DynamicResource L10n.common.close}" Click="OnCloseClicked" MinWidth="90" />
        </Grid>
    </Grid>
</Window>
