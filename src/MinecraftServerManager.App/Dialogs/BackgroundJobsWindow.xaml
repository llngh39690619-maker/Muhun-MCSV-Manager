<Window x:Class="MinecraftServerManager.App.Dialogs.BackgroundJobsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:MinecraftServerManager.App.ViewModels"
        Title="{DynamicResource L10n.jobs.window.title}"
        Width="920" Height="640" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}">
    <Window.Resources>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Rectangle Fill="{DynamicResource WindowBackgroundImageBrush}" IsHitTestVisible="False" />
        <Rectangle Fill="{DynamicResource WindowPatternBrush}" IsHitTestVisible="False" />

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource L10n.jobs.heading}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding BackgroundSchedulingProfile}"
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Padding="12,7" CornerRadius="12"
                        Background="{DynamicResource AccentDarkBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="{Binding BackgroundJobSummary}" FontWeight="SemiBold" />
                </Border>
            </Grid>

            <Border Grid.Row="1" Margin="0,14,0,12" Padding="12,9" CornerRadius="8"
                    Background="{DynamicResource PanelRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding BackgroundJobActivity}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Margin="0,7,0,0" Minimum="0" Maximum="100"
                                 Value="{Binding BackgroundJobProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsBackgroundJobProgressIndeterminate, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <ListBox Grid.Row="2" ItemsSource="{Binding BackgroundJobItems}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:BackgroundServerJobViewModel}">
                        <Border Margin="0,3" Padding="14" CornerRadius="9"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}">
                                        <Run Text="{Binding KindText, Mode=OneWay}" /><Run Text=" · " />
                                        <Run Text="{Binding TimeText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StateText}" Margin="0,0,12,0" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static viewModels:BackgroundServerJobState.Completed}">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static viewModels:BackgroundServerJobState.Failed}">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="{DynamicResource L10n.common.cancel}" Command="{Binding CancelCommand}" MinWidth="70" />
                                </StackPanel>

                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StageText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}"
                                               Style="{StaticResource MutedText}" Margin="10,0,0,0" />
                                </Grid>
                                <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Margin="0,7,0,0"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding ProgressPercentage, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" />
                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,7,0,0">
                                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource MutedText}"
                                               FontSize="12" TextWrapping="Wrap"
                                               Visibility="{Binding DetailText, Converter={StaticResource StringToVisibility}}" />
                                    <Border Margin="0,6,0,0" Padding="9" CornerRadius="6"
                                            Background="{DynamicResource WindowBrush}"
                                            BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                                                   TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource L10n.jobs.cleanupHint}"
                           Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{DynamicResource L10n.jobs.cancelAll}" Command="{Binding CancelAllBackgroundJobsCommand}"
                        Margin="8,0,0,0" />
                <Button Grid.Column="2" Content="{DynamicResource L10n.jobs.clearFinished}" Command="{Binding ClearFinishedBackgroundJobsCommand}"
                        Margin="8,0,0,0" />
                <Button Grid.Column="3" Content="{DynamicResource L10n.common.close}" Click="OnCloseClick" MinWidth="84" Margin="8,0,0,0" />
            </Grid>
        </Grid>
    </Grid>
</Window>
