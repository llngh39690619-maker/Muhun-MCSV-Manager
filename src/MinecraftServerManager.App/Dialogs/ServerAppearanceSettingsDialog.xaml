<Window x:Class="MinecraftServerManager.App.Dialogs.ServerAppearanceSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L10n.serverAppearance.window.title}" Width="760" Height="570" MinWidth="650" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold"><Run Text="{Binding SelectedServer.Name}" /><Run Text="{DynamicResource L10n.serverAppearance.headingSuffix}" /></TextBlock>
            <TextBlock Text="{DynamicResource L10n.serverAppearance.description}"
                       Style="{StaticResource MutedText}" Margin="0,5,0,14" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource L10n.serverAppearance.background}" FontSize="17" FontWeight="SemiBold" />
                    <Border Grid.Row="1" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="7" Margin="0,10" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding SelectedServer.BackgroundImagePath}" Stretch="UniformToFill"
                                   Opacity="{Binding SelectedServer.BackgroundImageOpacity}" />
                            <TextBlock Text="{DynamicResource L10n.serverAppearance.background.empty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Style="{StaticResource MutedText}"
                                       Visibility="{Binding SelectedServer.BackgroundImagePath, Converter={StaticResource EmptyStringToVisibility}}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="62" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource L10n.serverAppearance.opacity}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1"
                                Value="{Binding SelectedServer.BackgroundImageOpacityPercent}" Margin="10,0" />
                        <TextBlock Grid.Column="2" Text="{Binding SelectedServer.BackgroundImageOpacityPercent, StringFormat={}{0:0}%}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <WrapPanel Grid.Row="3">
                        <Button Content="{DynamicResource L10n.serverAppearance.background.choose}" Command="{Binding ChooseBackgroundCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                        <Button Content="{DynamicResource L10n.serverAppearance.background.clear}" Command="{Binding ClearBackgroundCommand}" Margin="0,0,0,8" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource L10n.serverAppearance.icon}" FontSize="17" FontWeight="SemiBold" />
                    <Border Grid.Row="1" Width="176" Height="176" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="16" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding SelectedServer.IconImagePath}" Stretch="UniformToFill" Opacity="1" />
                            <TextBlock Text="{DynamicResource L10n.serverAppearance.icon.empty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Style="{StaticResource MutedText}"
                                       Visibility="{Binding SelectedServer.IconImagePath, Converter={StaticResource EmptyStringToVisibility}}" />
                        </Grid>
                    </Border>
                    <WrapPanel Grid.Row="2" HorizontalAlignment="Center">
                        <Button Content="{DynamicResource L10n.serverAppearance.icon.choose}" Command="{Binding ChooseIconCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                        <Button Content="{DynamicResource L10n.common.delete}" Command="{Binding ClearIconCommand}" Margin="0,0,0,8" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource L10n.serverAppearance.applyOpacity}" Command="{Binding SaveServerAppearanceCommand}"
                    CommandParameter="{Binding SelectedServer}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
            <Button Content="{DynamicResource L10n.common.close}" MinWidth="86" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
