<Window x:Class="MinecraftServerManager.App.Dialogs.ModpackUpdateSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L10n.modpackUpdate.window.title}" Width="720" Height="570" MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource L10n.modpackUpdate.heading}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ServerName}" Style="{StaticResource MutedText}" Margin="0,5,0,14" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="9" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource L10n.online.source}" Style="{StaticResource MutedText}" />
                <TextBlock Grid.Column="1" Text="{Binding SourceDisplay}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="{DynamicResource L10n.modpackUpdate.current}" Style="{StaticResource MutedText}" Margin="0,9,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentVersionDisplay}" Margin="0,9,0,0" />
                <TextBlock Grid.Row="2" Text="{DynamicResource L10n.modpackUpdate.target}" Style="{StaticResource MutedText}" Margin="0,9,0,0" />
                <ComboBox x:Name="VersionPicker" Grid.Row="2" Grid.Column="1" Margin="0,7,0,0"
                          ItemsSource="{Binding AvailableVersions}" SelectedIndex="0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding VersionName}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource MutedText}" FontSize="11">
                                    <Run Text="Minecraft " /><Run Text="{Binding MinecraftVersion}" />
                                    <Run Text=" · " /><Run Text="{Binding Loader}" />
                                    <Run Text=" · " /><Run Text="{Binding ReleaseDateDisplay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource WindowBrush}"
                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                CornerRadius="9" Padding="14">
            <StackPanel>
                <TextBlock Text="{DynamicResource L10n.modpackUpdate.method}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Margin="0,9,0,0" TextWrapping="Wrap"
                           Text="{DynamicResource L10n.modpackUpdate.description}" />
                <TextBlock Margin="0,9,0,0" TextWrapping="Wrap"
                           Text="{DynamicResource L10n.modpackUpdate.preserved}" />
                <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                           Text="{DynamicResource L10n.modpackUpdate.warning}" />
                <CheckBox x:Name="AcknowledgementCheckBox" Margin="0,16,0,0"
                          Content="{DynamicResource L10n.modpackUpdate.acknowledge}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource L10n.common.cancel}" MinWidth="86" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="{DynamicResource L10n.modpackUpdate.confirm}" Style="{StaticResource PrimaryButton}" MinWidth="150"
                    Click="OnConfirmClick" />
        </StackPanel>
    </Grid>
</Window>
