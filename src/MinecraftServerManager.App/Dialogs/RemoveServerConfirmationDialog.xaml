<Window x:Class="MinecraftServerManager.App.Dialogs.RemoveServerConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L10n.removeServer.window.title}"
        Width="560" Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid x:Name="DialogRoot" Background="{DynamicResource WindowBrush}">
        <Rectangle Fill="{DynamicResource WindowBackgroundImageBrush}" IsHitTestVisible="False" />
        <Rectangle Fill="{DynamicResource WindowPatternBrush}" IsHitTestVisible="False" />

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{DynamicResource L10n.removeServer.heading}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource L10n.removeServer.description}"
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Margin="0,7,0,0" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource PanelRaisedBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14"
                    Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="15"
                            Background="{DynamicResource WindowBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Top">
                        <TextBlock Text="!" Foreground="{DynamicResource DangerBrush}"
                                   FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding ServerName}" FontSize="17" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource L10n.removeServer.preserved}"
                                   Style="{StaticResource MutedText}" Margin="0,10,0,4" />
                        <TextBlock Text="{Binding DirectoryPath}" TextWrapping="Wrap"
                                   FontFamily="Cascadia Mono, Consolas"
                                   ToolTip="{Binding DirectoryPath}" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="{DynamicResource L10n.common.cancel}" IsCancel="True" MinWidth="88" Margin="0,0,8,0"
                        AutomationProperties.Name="{DynamicResource L10n.removeServer.aria.cancel}" />
                <Button x:Name="ConfirmButton" Content="{DynamicResource L10n.common.confirm}" Style="{StaticResource DangerButton}" MinWidth="88"
                        Click="OnConfirmClick" AutomationProperties.Name="{DynamicResource L10n.removeServer.aria.confirm}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
