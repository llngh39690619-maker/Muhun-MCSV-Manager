<Window x:Class="MinecraftServerManager.App.Dialogs.OnlineModpackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MinecraftServerManager.App.Controls"
        Title="{DynamicResource L10n.online.window.title}"
        Width="1380" Height="860" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing">
    <Window.Resources>
        <Style x:Key="DialogPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="DialogLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="DarkFilterListBoxStyle" TargetType="ListBox"
               BasedOn="{StaticResource ThemedListBoxStyle}">
            <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="ProviderButtonItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="15,10">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterChipItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="11,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CatalogCardItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Height" Value="322" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="{DynamicResource PanelRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" ClipToBounds="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Rectangle Fill="{DynamicResource WindowBackgroundImageBrush}" IsHitTestVisible="False" />
        <Rectangle Fill="{DynamicResource WindowPatternBrush}" IsHitTestVisible="False" />
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource L10n.online.heading}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Margin="0,7,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="{DynamicResource L10n.online.description}" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource AccentDarkBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="12,5" VerticalAlignment="Top">
                    <TextBlock Text="{Binding ResultLimitText, Mode=OneWay}" FontSize="11" />
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource DialogPanel}" Margin="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <TextBlock Text="{DynamicResource L10n.online.source}" Style="{StaticResource DialogLabel}" />
                             <ListBox x:Name="ProviderBox" ItemsSource="{Binding Providers}"
                                      SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                      IsEnabled="{Binding CanChangeProvider}"
                                      Style="{StaticResource DarkFilterListBoxStyle}"
                                      ItemContainerStyle="{StaticResource ProviderButtonItem}"
                                     SelectionChanged="OnProviderSelectionChanged"
                                     AutomationProperties.Name="{DynamicResource L10n.online.source}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource L10n.online.officialKey}" FontSize="10" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding RequiresApiKey, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource L10n.online.searchPack}" Style="{StaticResource DialogLabel}" />
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsInputEnabled}"
                                     PreviewKeyDown="OnSearchBoxPreviewKeyDown"
                                     AutomationProperties.Name="{DynamicResource L10n.online.searchPack}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource L10n.online.sort}" Style="{StaticResource DialogLabel}" />
                            <ComboBox ItemsSource="{Binding SortChoices}"
                                      SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      IsEnabled="{Binding IsInputEnabled}"
                                      AutomationProperties.Name="{DynamicResource L10n.online.sort}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{DynamicResource L10n.online.gameVersion}" Style="{StaticResource DialogLabel}" />
                            <ComboBox ItemsSource="{Binding GameVersionChoices}"
                                      SelectedItem="{Binding SelectedGameVersion, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      IsEnabled="{Binding IsInputEnabled}"
                                      AutomationProperties.Name="{DynamicResource L10n.online.gameVersion}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="12,0,0,0">
                            <TextBlock Text="{DynamicResource L10n.online.resultLimit}" Style="{StaticResource DialogLabel}" />
                            <ComboBox ItemsSource="{Binding ResultLimitChoices}"
                                      SelectedItem="{Binding SelectedResultLimit, Mode=TwoWay}"
                                      IsEnabled="{Binding CanChangeProvider}"
                                      AutomationProperties.Name="{DynamicResource L10n.online.resultLimit}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource L10n.online.loader}" Style="{StaticResource DialogLabel}"
                                   VerticalAlignment="Center" Margin="0,0,12,5" />
                         <ListBox Grid.Column="1" ItemsSource="{Binding LoaderChoices}"
                                  SelectedItem="{Binding SelectedLoader, Mode=TwoWay}"
                                  Style="{StaticResource DarkFilterListBoxStyle}"
                                  ItemContainerStyle="{StaticResource FilterChipItem}"
                                  IsEnabled="{Binding IsInputEnabled}"
                                  AutomationProperties.Name="{DynamicResource L10n.online.loader}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding DisplayName, Mode=OneWay}" /></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="FeaturedButton" Content="{DynamicResource L10n.online.featured}" MinWidth="104" Margin="0,0,8,0"
                                    IsEnabled="{Binding CanLoadFeatured}" Click="OnFeaturedClick"
                                    AutomationProperties.Name="{DynamicResource L10n.online.featured}" />
                            <Button x:Name="SearchButton" Content="{DynamicResource L10n.online.search}" MinWidth="92" Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding CanSearch}" Click="OnSearchClick"
                                    AutomationProperties.Name="{DynamicResource L10n.online.search}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,3,0,0"
                          Visibility="{Binding HasCategories, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource L10n.online.category}" Style="{StaticResource DialogLabel}"
                                   VerticalAlignment="Center" Margin="0,0,12,5" />
                         <ListBox Grid.Column="1" ItemsSource="{Binding CategoryChoices}"
                                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                  Style="{StaticResource DarkFilterListBoxStyle}"
                                  ItemContainerStyle="{StaticResource FilterChipItem}"
                                  IsEnabled="{Binding IsInputEnabled}"
                                  AutomationProperties.Name="{DynamicResource L10n.online.category}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding DisplayName, Mode=OneWay}" /></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,6,0,3"
                          Visibility="{Binding IsCurseForgeSelected, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource L10n.online.curseForgeApiKey}"
                                   Style="{StaticResource DialogLabel}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <PasswordBox x:Name="CurseForgeApiKeyBox" Grid.Column="1" MaxLength="256"
                                      IsEnabled="{Binding IsInputEnabled}"
                                      PasswordChanged="OnCurseForgeApiKeyChanged"
                                      AutomationProperties.Name="{DynamicResource L10n.online.curseForgeApiKey}" />
                        <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource L10n.online.curseForgeApiKeyPrivacy}" />
                    </Grid>
                    <TextBlock Grid.Row="4" Text="{Binding ProviderAvailabilityText}" Margin="0,2,0,0"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="370" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource DialogPanel}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding ResultsHeading, Mode=OneWay}" FontSize="17"
                                   FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ListBox x:Name="ResultList" Grid.Row="1"
                                 ItemsSource="{Binding CatalogItems}"
                                 IsEnabled="{Binding IsInputEnabled}"
                                 Style="{StaticResource ThemedListBoxStyle}" Padding="2"
                                 ItemContainerStyle="{StaticResource CatalogCardItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False"
                                 SelectionChanged="OnResultSelectionChanged"
                                 AutomationProperties.Name="{DynamicResource L10n.online.results.aria}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:ResponsiveWrapPanel MinItemWidth="260"
                                                                  HorizontalSpacing="12"
                                                                  VerticalSpacing="12" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="128" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Background="{DynamicResource WindowBrush}" ClipToBounds="True">
                                            <Border>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="{DynamicResource PanelRaisedColor}" Offset="0" />
                                                        <GradientStop Color="{DynamicResource AccentDarkColor}" Offset="0.58" />
                                                        <GradientStop Color="{DynamicResource WindowColor}" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid ClipToBounds="True">
                                                    <Ellipse Width="170" Height="170" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                             Margin="0,-80,-35,0" Fill="{DynamicResource AccentBrush}" Opacity="0.08" />
                                                    <Ellipse Width="115" Height="115" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                             Margin="-48,0,0,-58" Stroke="{DynamicResource AccentBrush}"
                                                             StrokeThickness="18" Opacity="0.08" />
                                                    <TextBlock Text="{Binding Initial, Mode=OneWay}" FontSize="42" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}" Opacity="0.9"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ArtworkStatusText, Mode=OneWay}" FontSize="9"
                                                               Foreground="{DynamicResource MutedTextBrush}" Opacity="0.86"
                                                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10,0,10,8" />
                                                </Grid>
                                            </Border>
                                            <Image Source="{Binding Artwork, Mode=OneWay}"
                                                   Stretch="{Binding ArtworkStretch, Mode=OneWay}"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Opacity="0.98"
                                                   Visibility="{Binding HasArtwork, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                            <Border Background="#C0101318" CornerRadius="10" Padding="9,4"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                                <TextBlock Text="{Binding SourceDisplay, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="14,12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name, Mode=OneWay}" />
                                            <TextBlock Grid.Row="1" Margin="0,7,0,0" Text="{Binding Summary, Mode=OneWay}"
                                                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="56" />
                                            <TextBlock Grid.Row="2" Margin="0,7,0,0"
                                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{DynamicResource L10n.online.authorPrefix}" /><Run Text="{Binding Authors, Mode=OneWay}" />
                                            </TextBlock>
                                            <Grid Grid.Row="3" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DownloadCountDisplay, Mode=OneWay}" FontSize="10"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding UpdatedDisplay, Mode=OneWay}" FontSize="10"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource DialogPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource L10n.online.availableVersions}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding Versions}"
                                 SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                 IsEnabled="{Binding IsInputEnabled}" Style="{StaticResource ThemedListBoxStyle}"
                                 Padding="5" AutomationProperties.Name="{DynamicResource L10n.online.availableVersions}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,8">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding VersionName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding ReleaseChannel, Mode=OneWay}"
                                                   Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="8,0,0,0" />
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12">
                                            <Run Text="Minecraft " /><Run Text="{Binding MinecraftVersion, Mode=OneWay}" />
                                            <Run Text=" · " /><Run Text="{Binding Loader, Mode=OneWay}" />
                                            <Run Text=" · " /><Run Text="{Binding ReleaseDateDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,5,0,0"
                                                   Text="{Binding ServerPackStatus, Mode=OneWay}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasOfficialServerPack, Mode=OneWay}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="{Binding SelectedVersionAvailability}"
                                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding SelectedVersionAvailability, Converter={StaticResource StringToVisibility}}" />
                        <StackPanel Grid.Row="3" Margin="0,12,0,0">
                            <TextBlock Text="{DynamicResource L10n.online.serverName}" Style="{StaticResource DialogLabel}" />
                            <TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsInputEnabled}" AutomationProperties.Name="{DynamicResource L10n.online.serverName}" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Margin="0,12,0,0"
                                    Visibility="{Binding RequiresMinecraftEulaAcceptance, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox x:Name="MinecraftEulaAcceptanceCheckBox"
                                      IsChecked="{Binding MinecraftEulaAccepted, Mode=TwoWay}"
                                      IsEnabled="{Binding IsInputEnabled}"
                                      Content="{DynamicResource L10n.online.minecraftEula.accept}" />
                            <TextBlock Margin="22,7,0,0">
                                <Hyperlink NavigateUri="https://aka.ms/MinecraftEULA"
                                           RequestNavigate="OnMinecraftEulaLinkRequestNavigate">
                                    <Run Text="{DynamicResource L10n.online.minecraftEula.link}" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource DialogPanel}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StageText}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                   Text="{Binding ProgressPercentage, StringFormat={}{0:0}%}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Visibility="{Binding ShowProgressPercentage, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <TextBlock Margin="0,5,0,0" Text="{Binding ProgressDetailText, Mode=OneWay}"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"
                               Visibility="{Binding ProgressDetailText, Converter={StaticResource StringToVisibility}}" />
                    <ProgressBar Margin="0,9,0,0" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercentage, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <Border Margin="0,10,0,0" Padding="10" CornerRadius="6"
                            Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{Binding CancelButtonText}" MinWidth="96" Margin="0,0,8,0"
                        Click="OnCancelClick" AutomationProperties.Name="{DynamicResource L10n.online.cancelOrClose.aria}" />
                <Button Content="{DynamicResource L10n.online.downloadInstall}" Style="{StaticResource PrimaryButton}" MinWidth="128"
                        IsEnabled="{Binding CanInstall}" Click="OnInstallClick"
                        AutomationProperties.Name="{DynamicResource L10n.online.downloadInstall}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
