<Window x:Class="MinecraftServerManager.App.Dialogs.CurseForgeUpdateCredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="{DynamicResource L10n.modpackUpdate.curseForgeCredential.title}"
        Width="560" MinWidth="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Style="{StaticResource AppWindowStyle}"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="18" Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource L10n.modpackUpdate.curseForgeCredential.heading}"
                       FontSize="21" FontWeight="SemiBold" />
            <TextBlock Margin="0,7,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Text="{DynamicResource L10n.modpackUpdate.curseForgeCredential.description}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,16" Padding="15"
                Background="{DynamicResource PanelRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="9">
            <StackPanel>
                <TextBlock Text="{DynamicResource L10n.online.curseForgeApiKey}"
                           FontWeight="SemiBold" />
                <PasswordBox x:Name="ApiKeyInput" Margin="0,8,0,0" MaxLength="256"
                             AutomationProperties.Name="{DynamicResource L10n.online.curseForgeApiKey}" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{DynamicResource L10n.online.curseForgeApiKeyPrivacy}" />
                <TextBlock x:Name="ValidationText" Margin="0,8,0,0" Visibility="Collapsed"
                           TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                           Text="{DynamicResource L10n.modpackUpdate.curseForgeCredential.required}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource L10n.common.cancel}" MinWidth="92"
                    IsCancel="True" Margin="0,0,8,0" />
            <Button Content="{DynamicResource L10n.common.confirm}" MinWidth="110"
                    IsDefault="True" Style="{StaticResource PrimaryButton}"
                    Click="OnConfirmClick" />
        </StackPanel>
    </Grid>
</Window>
