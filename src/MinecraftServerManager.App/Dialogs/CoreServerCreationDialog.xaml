<Window x:Class="MinecraftServerManager.App.Dialogs.CoreServerCreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L10n.core.window.title}"
        Width="1060" Height="760" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing">
    <Window.Resources>
        <Style x:Key="CoreDialogPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="CoreDialogLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Rectangle Fill="{DynamicResource WindowBackgroundImageBrush}" IsHitTestVisible="False" />
        <Rectangle Fill="{DynamicResource WindowPatternBrush}" IsHitTestVisible="False" />

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{DynamicResource L10n.core.heading}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Margin="0,7,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Text="{DynamicResource L10n.core.description}" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,17,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.72*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.28*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CoreDialogPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource L10n.core.available}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid Grid.Row="1">
                            <ListBox x:Name="CoreList"
                                     ItemsSource="{Binding Cores}"
                                     IsEnabled="{Binding IsInputEnabled}"
                                     Style="{StaticResource ThemedListBoxStyle}"
                                     Padding="5"
                                     SelectionChanged="OnCoreSelectionChanged"
                                     AutomationProperties.Name="{DynamicResource L10n.core.aria.available}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="10,8">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="15"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,5,0,0" Text="{Binding Description}"
                                                       Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                       MaxHeight="42" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Margin="12" Padding="14" CornerRadius="7"
                                    Background="{DynamicResource PanelRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding CoreCatalogStateText, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="{Binding CoreCatalogStateText}" TextWrapping="Wrap"
                                           TextAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CoreDialogPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource L10n.core.versions}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource L10n.core.search}" Style="{StaticResource CoreDialogLabel}" />
                            <TextBox Text="{Binding VersionSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsInputEnabled}"
                                     AutomationProperties.Name="{DynamicResource L10n.core.aria.search}" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <ListBox ItemsSource="{Binding Versions}"
                                     SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                     IsEnabled="{Binding IsInputEnabled}"
                                     Style="{StaticResource ThemedListBoxStyle}"
                                     Padding="5"
                                     AutomationProperties.Name="{DynamicResource L10n.core.aria.versions}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" Margin="8,0,0,0" Padding="8,2"
                                                    CornerRadius="8" Background="{DynamicResource AccentDarkBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                                    Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{DynamicResource L10n.core.recommended}" FontSize="11" />
                                            </Border>
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0"
                                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="12">
                                                <Run Text="Minecraft " /><Run Text="{Binding MinecraftVersion, Mode=OneWay}" />
                                                <Run Text=" · " /><Run Text="{Binding BuildDisplay, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,5,0,0"
                                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="12">
                                                <Run Text="{DynamicResource L10n.core.published}" /><Run Text="{Binding ReleaseDateDisplay, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Margin="12" Padding="14" CornerRadius="7"
                                    Background="{DynamicResource PanelRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding VersionStateText, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="{Binding VersionStateText}" TextWrapping="Wrap"
                                           TextAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="3" Margin="0,12,0,0">
                            <TextBlock Text="{DynamicResource L10n.core.serverName}" Style="{StaticResource CoreDialogLabel}" />
                            <TextBox Text="{Binding ServerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsInputEnabled}"
                                     AutomationProperties.Name="{DynamicResource L10n.core.serverName}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CoreDialogPanel}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StageText}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                   Text="{Binding ProgressPercentage, Mode=OneWay, StringFormat={}{0:0}%}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Visibility="{Binding ShowProgressPercentage, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <ProgressBar x:Name="OverallProgressBar"
                                 Margin="0,9,0,0" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercentage, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Margin="0,9,0,0"
                                IsHitTestVisible="False"
                                Focusable="False"
                                Visibility="{Binding ShowDetailProgress, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding DetailText, Mode=OneWay}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="34" />
                        <ProgressBar x:Name="DetailProgressBar"
                                     Margin="0,6,0,0"
                                     Minimum="0" Maximum="100"
                                     IsIndeterminate="{Binding IsDetailIndeterminate}"
                                     IsHitTestVisible="False"
                                     Focusable="False"
                                     AutomationProperties.Name="{DynamicResource L10n.core.aria.detailProgress}" />
                    </StackPanel>
                    <Border Margin="0,10,0,0" Padding="10" CornerRadius="6"
                            Background="{DynamicResource WindowBrush}"
                            BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{Binding CancelButtonText}" MinWidth="96" Margin="0,0,8,0"
                        Click="OnCancelClick" AutomationProperties.Name="{DynamicResource L10n.core.aria.cancelOrClose}" />
                <Button x:Name="CreateServerButton"
                        Content="{DynamicResource L10n.core.create}" Style="{StaticResource PrimaryButton}" MinWidth="128"
                        IsEnabled="{Binding CanCreate}" Click="OnCreateClick"
                        AutomationProperties.Name="{DynamicResource L10n.core.create}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
