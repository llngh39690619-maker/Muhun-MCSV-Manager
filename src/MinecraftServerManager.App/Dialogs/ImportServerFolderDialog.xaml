<Window x:Class="MinecraftServerManager.App.Dialogs.ImportServerFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L10n.importFolder.window.title}" Width="720" Height="700"
        Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="DialogLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8" />
        </Style>
        <Style x:Key="DialogValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Rectangle Fill="{DynamicResource WindowBackgroundImageBrush}" IsHitTestVisible="False" />
        <Rectangle Fill="{DynamicResource WindowPatternBrush}" IsHitTestVisible="False" />
        <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16">
            <StackPanel>
                <TextBlock Text="{DynamicResource L10n.importFolder.heading}" Foreground="{DynamicResource TextBrush}"
                           FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding IntroText}" Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,7,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Margin="0,14,0,0" ClipToBounds="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="165" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource L10n.importFolder.folder}" Style="{StaticResource DialogLabel}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SourcePath}" Style="{StaticResource DialogValue}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" />
                <TextBlock Grid.Row="1" Text="{DynamicResource L10n.importFolder.modpack}" Style="{StaticResource DialogLabel}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PackDisplay}" Style="{StaticResource DialogValue}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Text="{DynamicResource L10n.importFolder.coreMinecraft}" Style="{StaticResource DialogLabel}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CoreDisplay}" Style="{StaticResource DialogValue}" />
                <TextBlock Grid.Row="3" Text="{DynamicResource L10n.importFolder.host}" Style="{StaticResource DialogLabel}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HostDisplay}" Style="{StaticResource DialogValue}"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Grid.Row="4" Text="{DynamicResource L10n.importFolder.launchSource}" Style="{StaticResource DialogLabel}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ScriptDisplay}" Style="{StaticResource DialogValue}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ScriptDisplay}" />
                <TextBlock Grid.Row="5" Text="{DynamicResource L10n.importFolder.javaArguments}" Style="{StaticResource DialogLabel}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ArgumentFilesDisplay}" Style="{StaticResource DialogValue}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="6" Text="Java" Style="{StaticResource DialogLabel}" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding JavaDisplay}" Style="{StaticResource DialogValue}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="7" Text="{DynamicResource L10n.importFolder.memorySource}" Style="{StaticResource DialogLabel}" />
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding MemoryDisplay}" Style="{StaticResource DialogValue}" />
                <TextBlock Grid.Row="8" Text="{DynamicResource L10n.online.serverName}" Style="{StaticResource DialogLabel}" />
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="{DynamicResource TextBrush}" Background="{DynamicResource WindowBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" Margin="0,3" />

                <Border Grid.Row="9" Grid.ColumnSpan="2" Background="{DynamicResource PanelRaisedBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,15,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding WarningText}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource L10n.importFolder.evidence}" Foreground="{DynamicResource WarningBrush}"
                                   FontWeight="SemiBold" Margin="0,10,0,4" />
                        <ItemsControl ItemsSource="{Binding Evidence}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat=• {0}}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                </Grid>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{DynamicResource L10n.common.cancel}" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource L10n.importFolder.add}" Click="OnConfirm" MinWidth="210" />
        </StackPanel>
        </Grid>
    </Grid>
</Window>
