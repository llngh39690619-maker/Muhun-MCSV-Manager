<Window x:Class="MinecraftServerManager.App.Dialogs.RemoteWebConsoleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="{DynamicResource L10n.remote.console.window.title}" Width="940" Height="620" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}" Closed="OnWindowClosed">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource L10n.remote.console.heading}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource L10n.remote.console.description}"
                           Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                <TextBlock Text="{DynamicResource L10n.remote.console.lifecycleHint}"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource PanelRaisedBrush}" CornerRadius="12" Padding="11,6" VerticalAlignment="Center">
                <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource L10n.remote.console.publicUrl}" Style="{StaticResource MutedText}" FontSize="11" />
                    <TextBox Text="{Binding PublicUrl, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" Margin="0,5,0,0" />
                    <WrapPanel Margin="0,9,0,0">
                        <TextBlock Text="PID：" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding ProcessIdText}" Margin="0,0,14,0" />
                        <TextBlock Text="{DynamicResource L10n.remote.console.versionLabel}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding VersionText}" Margin="0,0,14,0" />
                        <TextBlock Text="{DynamicResource L10n.remote.console.uptimeLabel}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding UptimeText}" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <Button Content="{DynamicResource L10n.remote.console.copyUrl}" Command="{Binding CopyUrlCommand}" Margin="0,0,0,7" />
                    <Button Content="{DynamicResource L10n.remote.console.openBrowser}" Command="{Binding OpenUrlCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#090B0E" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0" Padding="8"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource MutedTextBrush}" FontFamily="Cascadia Mono, Consolas" />
                            <TextBlock Grid.Column="1" Text="{Binding ChannelText}" Foreground="{DynamicResource WarningBrush}" FontFamily="Cascadia Mono, Consolas" />
                            <TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="Cascadia Mono, Consolas" TextWrapping="NoWrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource L10n.remote.console.stopWeb}" Command="{Binding StopCommand}" Foreground="{DynamicResource DangerBrush}" Margin="8,0,0,0" />
                <Button Content="{DynamicResource L10n.remote.console.reconnect}" Command="{Binding ReconnectCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
