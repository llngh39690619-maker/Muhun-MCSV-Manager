<Window x:Class="MinecraftServerManager.App.Dialogs.ProductNotificationSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MinecraftServerManager.App.Controls"
        Title="{DynamicResource L10n.notification.window.title}" Width="840" Height="760" MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}" Loaded="OnLoaded" Closed="OnClosed">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource L10n.notification.window.title}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource L10n.notification.description}"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,14" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="9" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource L10n.notification.provider.discord}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding WebhookConfigurationText}" TextWrapping="Wrap" Margin="0,5,0,10" />
                <TextBlock Text="{DynamicResource L10n.notification.discord.hint}"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:RevealPasswordBox Password="{Binding WebhookUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                MaxLength="512" />
                    <Button Grid.Column="1" Content="{DynamicResource L10n.notification.discord.store}" Command="{Binding ConfigureWebhookCommand}"
                            Style="{StaticResource PrimaryButton}" MinWidth="100" Margin="8,0,0,0" />
                    <Button Grid.Column="2" Content="{DynamicResource L10n.notification.discord.remove}" Command="{Binding RemoveWebhookCommand}"
                            Style="{StaticResource DangerButton}" MinWidth="78" Margin="8,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource PanelRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="9" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource L10n.notification.subscriptions.title}"
                           FontSize="18" FontWeight="SemiBold" />
                <WrapPanel Grid.Row="1" Margin="0,10,0,8">
                    <CheckBox Content="{DynamicResource L10n.notification.subscriptions.serverLifecycle}"
                              IsChecked="{Binding ServerLifecycle}" Margin="0,0,18,8" />
                    <CheckBox Content="{DynamicResource L10n.notification.subscriptions.backups}"
                              IsChecked="{Binding BackupOperations}" Margin="0,0,18,8" />
                    <CheckBox Content="{DynamicResource L10n.notification.subscriptions.modpacks}"
                              IsChecked="{Binding ModpackUpdates}" Margin="0,0,18,8" />
                    <CheckBox Content="{DynamicResource L10n.notification.subscriptions.productUpdates}"
                              IsChecked="{Binding ProductUpdates}" Margin="0,0,18,8" />
                    <CheckBox Content="{DynamicResource L10n.notification.subscriptions.providerHealth}"
                              IsChecked="{Binding ProviderHealth}" Margin="0,0,18,8" />
                </WrapPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource L10n.notification.subscriptions.throttle}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Text="{Binding ExternalThrottleSeconds, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="4" VerticalContentAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{DynamicResource L10n.notification.subscriptions.throttleHint}"
                               Style="{StaticResource MutedText}" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="10,0" />
                    <Button Grid.Column="3" Content="{DynamicResource L10n.notification.subscriptions.save}"
                            Command="{Binding SavePreferencesCommand}" Style="{StaticResource PrimaryButton}"
                            MinWidth="100" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource PanelRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="9" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="4,0,4,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L10n.notification.history.recent}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource L10n.notification.history.hint}"
                                   Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{DynamicResource L10n.common.refresh}" Command="{Binding RefreshCommand}"
                            MinWidth="96" VerticalAlignment="Center" />
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{Binding Deliveries}"
                          Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="{DynamicResource L10n.notification.column.provider}" Width="110" DisplayMemberBinding="{Binding Provider}" />
                            <GridViewColumn Header="{DynamicResource L10n.notification.column.state}" Width="110" DisplayMemberBinding="{Binding State}" />
                            <GridViewColumn Header="{DynamicResource L10n.notification.column.attempts}" Width="70" DisplayMemberBinding="{Binding AttemptCount}" />
                            <GridViewColumn Header="{DynamicResource L10n.notification.column.nextAttempt}" Width="165" DisplayMemberBinding="{Binding NextAttempt}" />
                            <GridViewColumn Header="{DynamicResource L10n.notification.column.result}" Width="290" DisplayMemberBinding="{Binding Result}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Style="{StaticResource MutedText}" Margin="0,0,12,0" />
            <Button Grid.Column="1" Content="{DynamicResource L10n.common.close}" Command="{Binding CloseCommand}" MinWidth="88" />
        </Grid>
    </Grid>
</Window>
