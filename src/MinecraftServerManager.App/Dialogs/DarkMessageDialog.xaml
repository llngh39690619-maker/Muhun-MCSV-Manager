<Window x:Class="MinecraftServerManager.App.Dialogs.DarkMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Width="540" MinWidth="420" MaxWidth="680" MaxHeight="680"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="OnWindowClosing"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid x:Name="DialogRoot" Background="{DynamicResource WindowBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="IconSurface"
                    Width="42" Height="42" Margin="0,0,14,0"
                    CornerRadius="21"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1">
                <TextBlock x:Name="IconGlyph"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <TextBlock x:Name="CaptionText" Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="19" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Grid>

        <Border Grid.Row="1" Margin="0,16,0,16" Padding="15"
                Background="{DynamicResource PanelRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="9">
            <ScrollViewer MaxHeight="390"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Background="Transparent">
                <TextBlock x:Name="MessageText"
                           TextWrapping="Wrap"
                           LineHeight="21"
                           Foreground="{DynamicResource TextBrush}" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SecondaryButton"
                    MinWidth="92" Margin="0,0,8,0"
                    Click="OnSecondaryButtonClick" />
            <Button x:Name="PrimaryButton"
                    MinWidth="92"
                    Style="{StaticResource PrimaryButton}"
                    Click="OnPrimaryButtonClick" />
        </StackPanel>
    </Grid>
</Window>
