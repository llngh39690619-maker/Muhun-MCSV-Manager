<Window x:Class="MinecraftServerManager.App.Dialogs.GeneralSettingsUnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="{DynamicResource L10n.settings.unsaved.title}"
        Width="420" Height="200" MinWidth="420" MinHeight="200" MaxWidth="420" MaxHeight="200"
        SizeToContent="Manual" ResizeMode="NoResize" WindowState="Normal"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource WindowBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource PanelRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="9" Padding="18">
            <TextBlock Text="{DynamicResource L10n.settings.unsaved.heading}"
                       FontSize="18" FontWeight="SemiBold"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource L10n.common.cancel}" MinWidth="88" Click="OnCancelClick" Margin="0,0,8,0" />
            <Button Content="{DynamicResource L10n.common.save}" MinWidth="88" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
