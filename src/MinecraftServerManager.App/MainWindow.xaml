<Window x:Class="MinecraftServerManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MinecraftServerManager.App.Views"
        mc:Ignorable="d"
        Title="{DynamicResource L10n.main.window.title}"
        Width="{Binding WindowWidth, Mode=OneWay}" Height="{Binding WindowHeight, Mode=OneWay}" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}"
        Loaded="OnWindowLoaded"
        LocationChanged="OnWindowLocationChanged"
        SizeChanged="OnWindowSizeChanged"
        StateChanged="OnWindowStateChanged"
        Closing="OnWindowClosing"
        Closed="OnWindowClosed">
    <Window.Resources>
        <DataTemplate x:Key="ConsoleLineTemplate">
            <Grid Margin="4,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="{DynamicResource MutedTextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource SmallFontSize}" />
                <TextBlock Grid.Column="1" Text="{Binding StreamText}" Foreground="{Binding StreamBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource SmallFontSize}" />
                <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{Binding TextBrush}" FontFamily="Cascadia Mono, Consolas"
                           FontSize="{DynamicResource ConsoleFontSize}" TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ConsolePaneTemplate">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Margin="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="48" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource PanelRaisedBrush}" CornerRadius="9,9,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Fill="{Binding State, Converter={StaticResource StatusBrush}}" Margin="0,0,9,0" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="  •  " Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding StateText}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ConsoleCountText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding ConsoleLines}" ItemTemplate="{StaticResource ConsoleLineTemplate}"
                             Background="{DynamicResource WindowBrush}" BorderThickness="0" Padding="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             Loaded="OnConsoleListLoaded" Unloaded="OnConsoleListUnloaded"
                             DataContextChanged="OnConsoleListDataContextChanged" />
                    <Grid Grid.Row="2" Margin="8,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSendCommand}"
                                 ToolTip="{DynamicResource L10n.main.console.commandTooltip}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendCommandCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="{DynamicResource L10n.common.send}" Command="{Binding SendCommandCommand}" Margin="8,0,0,0" MinWidth="74" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DiagnosticPaneTemplate">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Margin="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource PanelRaisedBrush}" CornerRadius="9,9,0,0"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Fill="{Binding State, Converter={StaticResource StatusBrush}}" Margin="0,0,9,0" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="  •  " Style="{StaticResource MutedText}" />
                                <TextBlock Text="{DynamicResource L10n.main.tab.diagnostics}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding DiagnosticCountText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Background="{DynamicResource WindowBrush}">
                        <ListBox ItemsSource="{Binding DiagnosticLines}" ItemTemplate="{StaticResource ConsoleLineTemplate}"
                                 Background="Transparent" BorderThickness="0" Padding="6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 Loaded="OnConsoleListLoaded" Unloaded="OnConsoleListUnloaded"
                                 DataContextChanged="OnConsoleListDataContextChanged" />
                        <TextBlock Text="{DynamicResource L10n.main.diagnostics.empty}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDiagnosticLines}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Margin" Value="0,12,0,5" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Rectangle Fill="{DynamicResource WindowBackgroundImageBrush}" IsHitTestVisible="False" />
        <Rectangle Fill="{DynamicResource WindowPatternBrush}" IsHitTestVisible="False" />
        <Image Source="{Binding SelectedServer.BackgroundImagePath}" Stretch="UniformToFill"
               Opacity="{Binding SelectedServer.BackgroundImageOpacity}" IsHitTestVisible="False"
               Visibility="{Binding IsServerWorkspace, Converter={StaticResource BoolToVisibility}}" />

        <Grid Visibility="{Binding IsServerWorkspace, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L10n.app.brand.mark}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text="{DynamicResource L10n.app.brand.name}" FontWeight="SemiBold" FontSize="21" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{DynamicResource L10n.main.workspace.server}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" MinWidth="102" />
                        <Button Content="{DynamicResource L10n.main.workspace.client}" Command="{Binding ShowClientWorkspaceCommand}" Margin="0,0,12,0" MinWidth="102" />
                        <Button x:Name="ToggleBulkSelectionButton"
                                Content="{DynamicResource L10n.main.select}"
                                Command="{Binding ToggleBulkSelectionModeCommand}"
                                Margin="0,0,8,0"
                                ToolTip="{DynamicResource L10n.main.bulkSelection.tooltip}"
                                AutomationProperties.Name="{DynamicResource L10n.main.bulkSelection.automation}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBulkSelectionMode}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="StartCheckedServersButton"
                                Content="{DynamicResource L10n.main.startSelected}"
                                Command="{Binding StartCheckedServersCommand}"
                                Margin="0,0,8,0"
                                ToolTip="{DynamicResource L10n.main.startSelected.tooltip}"
                                AutomationProperties.Name="{DynamicResource L10n.main.startSelected.automation}" />
                        <Button x:Name="StopCheckedServersButton"
                                Content="{DynamicResource L10n.main.stopSelected}"
                                Command="{Binding StopCheckedServersCommand}"
                                ToolTip="{DynamicResource L10n.main.stopSelected.tooltip}"
                                AutomationProperties.Name="{DynamicResource L10n.main.stopSelected.automation}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RunningSummary}" Style="{StaticResource MutedText}" Margin="0,0,18,0" VerticalAlignment="Center" />
                        <Button Content="{DynamicResource L10n.main.remoteManagement}" Command="{Binding OpenRemoteManagementCommand}" Margin="0,0,8,0"
                                ToolTip="{DynamicResource L10n.main.remoteManagement.tooltip}"
                                AutomationProperties.Name="{DynamicResource L10n.main.remoteManagement.automation}" />
                        <Button Content="{DynamicResource L10n.main.openDataDirectory}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                        <Button Content="⚙" Command="{Binding OpenSettingsCommand}"
                                Width="40" MinWidth="40" Padding="8" FontSize="17"
                                ToolTip="{DynamicResource L10n.main.settingsTooltip}" AutomationProperties.Name="{DynamicResource L10n.main.settingsTooltip}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="2,2,2,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L10n.main.serverList}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ServerCountText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,2"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}">
                                        <Border.ContextMenu>
                                            <!-- A ContextMenu is hosted in a separate popup tree. Bind through its
                                                 placement target so both the command owner and the exact row remain
                                                 explicit even when the user right-clicks a non-selected Server. -->
                                            <ContextMenu Style="{DynamicResource ThemedContextMenuStyle}"
                                                         DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="{DynamicResource L10n.main.context.appearance}"
                                                          Style="{DynamicResource ThemedContextMenuItemStyle}"
                                                          Command="{Binding Tag.OpenServerAppearanceCommand}"
                                                          CommandParameter="{Binding DataContext}" />
                                                <Separator />
                                                <MenuItem Header="{DynamicResource L10n.main.context.remove}"
                                                          Style="{DynamicResource ThemedContextMenuItemStyle}"
                                                          Command="{Binding Tag.RemoveServerCommand}"
                                                          CommandParameter="{Binding DataContext}" />
                                                <Separator />
                                                <MenuItem Header="{DynamicResource L10n.main.context.delete}"
                                                          Style="{DynamicResource ThemedContextMenuItemStyle}"
                                                          Foreground="{DynamicResource DangerBrush}"
                                                          Command="{Binding Tag.DeleteServerCommand}"
                                                          CommandParameter="{Binding DataContext}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="BulkServerSelectionCheckBox"
                                                      Grid.Column="0"
                                                      Tag="BulkServerSelection"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsBulkSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Visibility="{Binding DataContext.IsBulkSelectionMode, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Converter={StaticResource BoolToVisibility}}"
                                                      AutomationProperties.Name="{DynamicResource L10n.main.bulkSelection.serverAutomation}">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox">
                                                        <Setter Property="IsEnabled" Value="True" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsBatchLifecycleOperationRunning, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                                         Value="True">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>
                                            <Border Grid.Column="1" Width="30" Height="30" CornerRadius="6" Background="{DynamicResource PanelRaisedBrush}" VerticalAlignment="Center">
                                                <Grid>
                                                    <TextBlock Text="{Binding CoreInitial}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding EffectiveIconImagePath, Converter={StaticResource EmptyStringToVisibility}}" />
                                                    <Image Source="{Binding EffectiveIconImagePath}" Stretch="UniformToFill" Opacity="1"
                                                           Visibility="{Binding EffectiveIconImagePath, Converter={StaticResource StringToVisibility}}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="2" Margin="9,0,4,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Ellipse Width="9" Height="9" Fill="{Binding State, Converter={StaticResource StatusBrush}}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding StateText}" FontSize="9" Foreground="{Binding State, Converter={StaticResource StatusBrush}}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource L10n.main.onlineModpack}" Command="{Binding InstallOnlineModpackCommand}" Margin="0,0,0,7" />
                            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource L10n.main.importServer}" Command="{Binding ImportExistingServerCommand}" Margin="0,0,0,7" />
                            <Button Content="{DynamicResource L10n.main.createCore}" Command="{Binding CreateCoreServerCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="14" Visibility="{Binding HasSelectedServer, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedServer.Name}" FontSize="25" FontWeight="SemiBold" />
                                <Border Background="{DynamicResource AccentDarkBrush}" CornerRadius="5" Padding="8,3" Margin="10,2,0,0">
                                    <TextBlock Text="{Binding SelectedServer.StateText}" Foreground="{Binding SelectedServer.State, Converter={StaticResource StatusBrush}}" FontSize="12" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedServer.DetailSubtitle}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource L10n.main.action.start}" Command="{Binding StartSelectedCommand}" Margin="0,0,7,0" />
                            <Button Content="{DynamicResource L10n.main.action.stop}" Command="{Binding StopSelectedCommand}" Margin="0,0,7,0" />
                            <Button Content="{DynamicResource L10n.main.action.restart}" Command="{Binding RestartSelectedCommand}" Margin="0,0,7,0" />
                            <Button Content="{DynamicResource L10n.main.action.openFolder}" Command="{Binding OpenSelectedFolderCommand}" />
                        </StackPanel>
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,10">
                        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource L10n.main.metric.cpu}" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding SelectedServer.CpuDisplay}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource L10n.main.metric.memory}" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding SelectedServer.MemoryDisplay}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource L10n.main.metric.port}" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding SelectedServer.Port}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource L10n.main.metric.java}" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding SelectedServer.JavaDisplay}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource L10n.main.metric.uptime}" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding SelectedServer.UptimeDisplay}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Border>
                    </UniformGrid>

                    <TabControl Grid.Row="2" SelectedValuePath="Tag"
                                SelectedValue="{Binding SelectedWorkspaceTabKey, Mode=TwoWay}">
                        <TabItem Header="{DynamicResource L10n.main.tab.console}" Tag="Console">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Grid.Column="0" Content="{Binding SelectedServer}" ContentTemplate="{StaticResource ConsolePaneTemplate}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Grid.ColumnSpan" Value="3" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSplitConsoleVisible}" Value="True">
                                                    <Setter Property="Grid.ColumnSpan" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{DynamicResource BorderBrush}"
                                              Visibility="{Binding IsSplitConsoleVisible, Converter={StaticResource BoolToVisibility}}" />
                                <Grid Grid.Column="2" Visibility="{Binding IsSplitConsoleVisible, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <ComboBox Grid.Row="0" ItemsSource="{Binding Servers}" SelectedItem="{Binding SecondaryServer}"
                                              DisplayMemberPath="Name" Margin="4,4,4,6" />
                                    <ContentControl Grid.Row="1" Content="{Binding SecondaryServer}" ContentTemplate="{StaticResource ConsolePaneTemplate}" />
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="{Binding SelectedServer.DiagnosticsTabHeader}" Tag="Diagnostics"
                                 Visibility="{Binding SelectedServer.SeparateDiagnosticOutput, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Grid.Column="0" Content="{Binding SelectedServer}" ContentTemplate="{StaticResource DiagnosticPaneTemplate}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Grid.ColumnSpan" Value="3" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSplitDiagnosticOutputVisible}" Value="True">
                                                    <Setter Property="Grid.ColumnSpan" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{DynamicResource BorderBrush}"
                                              Visibility="{Binding IsSplitDiagnosticOutputVisible, Converter={StaticResource BoolToVisibility}}" />
                                <Grid Grid.Column="2" Visibility="{Binding IsSplitDiagnosticOutputVisible, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <ComboBox Grid.Row="0" ItemsSource="{Binding Servers}" SelectedItem="{Binding SecondaryServer}"
                                              DisplayMemberPath="Name" Margin="4,4,4,6" />
                                    <ContentControl Grid.Row="1" Content="{Binding SecondaryServer}" ContentTemplate="{StaticResource DiagnosticPaneTemplate}" />
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="{DynamicResource L10n.main.tab.players}" Tag="Players">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource L10n.main.players.heading}" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{DynamicResource L10n.main.players.description}"
                                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedServer.PlayerSummary}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <CheckBox Content="{DynamicResource L10n.main.players.showKnown}" IsChecked="{Binding SelectedServer.ShowKnownPlayers}"
                                                  VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Content="{DynamicResource L10n.main.players.reloadLocal}"
                                                Command="{Binding RefreshPlayersCommand}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.35*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8">
                                        <Grid>
                                        <TextBlock Text="{Binding SelectedServer.EmptyPlayerListText}" Style="{StaticResource MutedText}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding SelectedServer.HasVisiblePlayers, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <ListBox ItemsSource="{Binding SelectedServer.VisiblePlayers}" SelectedItem="{Binding SelectedServer.SelectedPlayer}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 Visibility="{Binding SelectedServer.HasVisiblePlayers, Converter={StaticResource BoolToVisibility}}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="10" Margin="0,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="95" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                                <TextBlock Text="{Binding Uuid}" Style="{StaticResource MutedText}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding OnlineText}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="2" Text="{Binding RoleText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextAlignment="Right" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="18"
                                            IsEnabled="{Binding SelectedServer.CanManagePlayers}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource L10n.main.players.actionsHeading}" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="{DynamicResource L10n.main.players.actionsHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,12" />
                                            <TextBlock Text="{DynamicResource L10n.main.players.name}" Style="{StaticResource FormLabel}" />
                                            <TextBox Text="{Binding SelectedServer.PlayerNameInput, UpdateSourceTrigger=PropertyChanged}" />
                                            <WrapPanel Margin="0,14,0,0">
                                                <Button Content="{DynamicResource L10n.main.players.kick}" Command="{Binding KickPlayerCommand}" Margin="0,0,8,8" />
                                                <Button Style="{StaticResource DangerButton}" Content="{DynamicResource L10n.main.players.ban}" Command="{Binding BanPlayerCommand}" Margin="0,0,8,8" />
                                                <Button Content="{DynamicResource L10n.main.players.pardon}" Command="{Binding PardonPlayerCommand}" Margin="0,0,8,8" />
                                                <Button Content="{DynamicResource L10n.main.players.op}" Command="{Binding OpPlayerCommand}" Margin="0,0,8,8" />
                                                <Button Content="{DynamicResource L10n.main.players.deop}" Command="{Binding DeopPlayerCommand}" Margin="0,0,8,8" />
                                            </WrapPanel>
                                            <TextBlock Text="{DynamicResource L10n.main.players.whitelist}" FontWeight="SemiBold" Margin="0,12,0,8" />
                                            <WrapPanel>
                                                <Button Content="{DynamicResource L10n.main.players.whitelistAdd}" Command="{Binding WhitelistAddCommand}" Margin="0,0,8,8" />
                                                <Button Content="{DynamicResource L10n.main.players.whitelistRemove}" Command="{Binding WhitelistRemoveCommand}" Margin="0,0,8,8" />
                                                <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource L10n.main.players.whitelistOn}" Command="{Binding WhitelistOnCommand}" Margin="0,0,8,8" />
                                                <Button Content="{DynamicResource L10n.main.players.whitelistOff}" Command="{Binding WhitelistOffCommand}" Margin="0,0,8,8" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="{DynamicResource L10n.main.tab.settings}" Tag="ServerSettings">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8">
                                <Grid MaxWidth="1050" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource L10n.main.settings.startupHeading}" Style="{StaticResource SectionTitle}" />
                                        <Border x:Name="OneDrivePerformanceWarningBanner"
                                                Background="{DynamicResource PanelRaisedBrush}"
                                                BorderBrush="{DynamicResource WarningBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12"
                                                Margin="0,0,0,12"
                                                Visibility="{Binding SelectedServer.IsInOneDriveSyncFolder, Converter={StaticResource BoolToVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="!" Foreground="{DynamicResource WarningBrush}"
                                                           FontWeight="Bold" FontSize="18" Margin="0,0,10,0"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SelectedServer.OneDrivePerformanceWarning}"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                        <Border Background="{DynamicResource PanelRaisedBrush}"
                                                BorderBrush="{DynamicResource WarningBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12"
                                                Visibility="{Binding HasSelectedInstanceConfigurationStatus, Converter={StaticResource BoolToVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectedInstanceConfigurationStatusText}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                                        Content="{DynamicResource L10n.main.service.updateAction}"
                                                        Command="{Binding UpdateProductServiceCommand}"
                                                        Visibility="{Binding ShowProductServiceUpdateAction, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel IsEnabled="{Binding CanEditSelectedInstanceConfiguration}">
                                        <TextBlock Text="{DynamicResource L10n.main.settings.displayName}" Style="{StaticResource FormLabel}" />
                                        <TextBox Text="{Binding SelectedServer.Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{DynamicResource L10n.main.settings.launchTarget}" Style="{StaticResource FormLabel}" />
                                        <TextBox Text="{Binding SelectedServer.LaunchTargetPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource L10n.main.settings.javaExecutable}" Style="{StaticResource FormLabel}" />
                                        <TextBox Text="{Binding SelectedServer.JavaExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding SelectedServer.IsServiceManaged}" />
                                        <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{DynamicResource L10n.main.memory.heading}" FontSize="16" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedServer.MemoryRangeDisplay}" Style="{StaticResource MutedText}" />
                                                </Grid>
                                                <TextBlock Text="{Binding SelectedServer.SystemMemoryDisplay}" Style="{StaticResource MutedText}"
                                                           FontSize="11" Margin="0,5,0,0" />
                                                <WrapPanel Margin="0,10,0,8" IsEnabled="{Binding CanEditSelectedInstanceConfiguration}">
                                                    <RadioButton GroupName="ServerMemoryMode" Content="{DynamicResource L10n.main.memory.unspecified}"
                                                                 IsChecked="{Binding SelectedServer.IsMemoryUsingDefault}" Margin="0,0,14,6" />
                                                    <RadioButton GroupName="ServerMemoryMode" Content="{DynamicResource L10n.main.memory.automatic}"
                                                                 IsChecked="{Binding SelectedServer.IsMemoryAutomatic}" Margin="0,0,14,6" />
                                                    <RadioButton GroupName="ServerMemoryMode" Content="{DynamicResource L10n.main.memory.manual}"
                                                                 IsChecked="{Binding SelectedServer.IsMemoryManual}" Margin="0,0,0,6" />
                                                    <Button Content="{DynamicResource L10n.main.memory.recalculate}" Command="{Binding SelectedServer.RecalculateAutomaticMemoryCommand}"
                                                            Margin="14,0,0,6" Padding="10,4"
                                                            Visibility="{Binding SelectedServer.IsMemoryAutomatic, Converter={StaticResource BoolToVisibility}}" />
                                                </WrapPanel>
                                                <ProgressBar Height="3" IsIndeterminate="True" Margin="0,0,0,7"
                                                             Visibility="{Binding SelectedServer.IsAutomaticMemoryRecommendationRunning, Converter={StaticResource BoolToVisibility}}" />
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{DynamicResource L10n.main.memory.minimum}" VerticalAlignment="Center" />
                                                    <Slider Grid.Column="1" Minimum="512" Maximum="{Binding SelectedServer.MemorySliderMaximumMb}"
                                                            TickFrequency="256" IsSnapToTickEnabled="True"
                                                            Value="{Binding SelectedServer.MinimumMemorySliderMb}" Margin="8,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding SelectedServer.MinimumMemoryMb, StringFormat={}{0:N0} MB}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid Margin="0,7,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{DynamicResource L10n.main.memory.maximum}" VerticalAlignment="Center" />
                                                    <Slider Grid.Column="1" Minimum="512" Maximum="{Binding SelectedServer.MemorySliderMaximumMb}"
                                                            TickFrequency="256" IsSnapToTickEnabled="True"
                                                            Value="{Binding SelectedServer.MaximumMemorySliderMb}" Margin="8,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding SelectedServer.MaximumMemoryMb, StringFormat={}{0:N0} MB}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="{Binding SelectedServer.MemoryConfigurationHint}" Style="{StaticResource MutedText}"
                                                           FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Border>
                                         <TextBlock Text="{DynamicResource L10n.main.settings.port}" Style="{StaticResource FormLabel}" />
                                         <TextBox Text="{Binding SelectedServer.Port, UpdateSourceTrigger=PropertyChanged}" />
                                         <TextBlock Text="{DynamicResource L10n.main.settings.portHint}"
                                                    Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                         <CheckBox Content="{DynamicResource L10n.main.settings.autoRestart}"
                                                   IsChecked="{Binding SelectedServer.AutoRestart}" Margin="0,16,0,0" />
                                         <TextBlock Text="{DynamicResource L10n.main.settings.autoRestartHint}"
                                                    Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="24,5,0,0" />

                                         <CheckBox Content="{DynamicResource L10n.main.settings.separateDiagnostics}"
                                                   IsChecked="{Binding SelectedServer.SeparateDiagnosticOutput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Margin="0,16,0,0" />
                                         <TextBlock Text="{DynamicResource L10n.main.settings.separateDiagnosticsHint}"
                                                    Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="24,5,0,0" />

                                         <CheckBox Content="{DynamicResource L10n.main.settings.watchdog}"
                                                   IsChecked="{Binding SelectedServer.EnableHangWatchdog}" Margin="0,16,0,0"
                                                   IsEnabled="{Binding CanEditSelectedInstanceConfiguration}" />
                                         <TextBlock Text="{DynamicResource L10n.main.settings.watchdogHint}"
                                                    Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="24,5,0,0" />
                                         <Grid Margin="24,8,0,0" IsEnabled="{Binding SelectedServer.EnableHangWatchdog}">
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                                                 <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                                                 <ColumnDefinition Width="*" />
                                             </Grid.ColumnDefinitions>
                                             <StackPanel Grid.Column="0">
                                                 <TextBlock Text="{DynamicResource L10n.main.settings.watchdogInterval}" Style="{StaticResource FormLabel}" />
                                                 <TextBox Text="{Binding SelectedServer.WatchdogCheckIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                             </StackPanel>
                                             <StackPanel Grid.Column="2">
                                                 <TextBlock Text="{DynamicResource L10n.main.settings.watchdogTimeout}" Style="{StaticResource FormLabel}" />
                                                 <TextBox Text="{Binding SelectedServer.WatchdogProbeTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                             </StackPanel>
                                             <StackPanel Grid.Column="4">
                                                 <TextBlock Text="{DynamicResource L10n.main.settings.watchdogFailures}" Style="{StaticResource FormLabel}" />
                                                 <TextBox Text="{Binding SelectedServer.WatchdogFailureThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                             </StackPanel>
                                         </Grid>
                                         <TextBlock Text="{DynamicResource L10n.main.settings.watchdogStartupGrace}" Style="{StaticResource FormLabel}" Margin="24,8,0,0" />
                                         <TextBox Text="{Binding SelectedServer.WatchdogStartupGraceSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding SelectedServer.EnableHangWatchdog}" Margin="24,0,0,0" />

                                         <CheckBox Content="{DynamicResource L10n.main.settings.recoveryPoints}"
                                                   IsChecked="{Binding SelectedServer.EnableAutomaticRecoveryPoints}" Margin="0,16,0,0"
                                                   IsEnabled="{Binding CanEditSelectedInstanceConfiguration}" />
                                         <TextBlock Text="{DynamicResource L10n.main.settings.recoveryPointsHint}"
                                                    Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="24,5,0,0" />
                                         <Grid Margin="24,8,0,0" IsEnabled="{Binding SelectedServer.EnableAutomaticRecoveryPoints}">
                                             <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                             <StackPanel Grid.Column="0">
                                                 <TextBlock Text="{DynamicResource L10n.main.settings.recoveryInterval}" Style="{StaticResource FormLabel}" />
                                                 <TextBox Text="{Binding SelectedServer.RecoveryPointIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                             </StackPanel>
                                             <StackPanel Grid.Column="2">
                                                 <TextBlock Text="{DynamicResource L10n.main.settings.recoveryRetention}" Style="{StaticResource FormLabel}" />
                                                 <TextBox Text="{Binding SelectedServer.RecoveryPointRetentionCount, UpdateSourceTrigger=PropertyChanged}" />
                                             </StackPanel>
                                         </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource L10n.main.action.saveSettings}" Command="{Binding SaveSelectedSettingsCommand}" />
                                        </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource L10n.main.properties.heading}" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{DynamicResource L10n.main.properties.hint}"
                                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <Border Background="{DynamicResource PanelRaisedBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                                                Visibility="{Binding HasSelectedServerPropertiesStatus, Converter={StaticResource BoolToVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectedServerPropertiesStatusText}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                                        Content="{DynamicResource L10n.main.service.updateAction}"
                                                        Command="{Binding UpdateProductServiceCommand}"
                                                        Visibility="{Binding ShowProductServiceUpdateAction, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                        <TextBox Text="{Binding SelectedServer.ServerPropertiesText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding CanEditSelectedServerProperties}"
                                                 AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="430" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="{DynamicResource L10n.main.properties.reload}" Command="{Binding ReloadPropertiesCommand}" Margin="0,0,8,0" />
                                            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource L10n.main.properties.save}" Command="{Binding SavePropertiesCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="{DynamicResource L10n.main.tab.addons}" Tag="Addons"
                                 IsEnabled="{Binding CanBrowseSelectedServerFiles}">
                            <Grid Margin="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L10n.main.addons.heading}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{DynamicResource L10n.main.addons.hint}"
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,12">
                                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource L10n.main.addons.check}" Command="{Binding CheckAddonUpdatesCommand}" Margin="0,0,8,0" />
                                    <Button Content="{DynamicResource L10n.main.addons.openFolder}" Command="{Binding OpenAddonFolderCommand}" />
                                </StackPanel>
                                <Border Grid.Row="2" Background="{DynamicResource PanelRaisedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource L10n.main.modpackUpdate.heading}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedServer.ModpackSourceDisplay}" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                                            <TextBlock Text="{DynamicResource L10n.main.modpackUpdate.hint}"
                                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,16,0" />
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Button Content="{DynamicResource L10n.main.modpackUpdate.openBackups}"
                                                    Command="{Binding OpenModpackUpdateBackupsCommand}"
                                                    IsEnabled="{Binding CanEditSelectedLocalConfiguration}" Margin="0,0,8,8" />
                                            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource L10n.main.modpackUpdate.start}"
                                                    Command="{Binding UpdateSelectedModpackCommand}" Margin="0,0,0,8" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                                <ListBox Grid.Row="3" ItemsSource="{Binding SelectedServer.AddonUpdates}" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="130" /><ColumnDefinition Width="2*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ProjectDisplay}" Style="{StaticResource MutedText}" FontSize="11" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{DynamicResource L10n.main.addons.currentVersion}" Style="{StaticResource MutedText}" FontSize="11" />
                                                        <TextBlock Text="{Binding CurrentDisplay}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{DynamicResource L10n.main.addons.latestCompatible}" Style="{StaticResource MutedText}" FontSize="11" />
                                                        <TextBlock Text="{Binding LatestDisplay}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding UpdateLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>

                        <TabItem Header="{DynamicResource L10n.main.tab.java}" Tag="JavaRuntime">
                            <Grid Margin="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource L10n.main.java.heading}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Grid.Row="1" Text="{DynamicResource L10n.main.java.hint}"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="{DynamicResource L10n.service.readOnly.java}"
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                               Visibility="{Binding IsProductServiceRuntime, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding IsProductServiceRuntime, Converter={StaticResource InverseBoolToVisibility}}">
                                        <ComboBox Width="190" ItemsSource="{Binding JavaMajorChoices}" SelectedItem="{Binding SelectedJavaMajor}" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource L10n.main.java.downloadTemurin}" Command="{Binding DownloadJavaCommand}" Margin="8,0,0,0" />
                                        <Button Content="{DynamicResource L10n.main.java.scanInstalled}" Command="{Binding RefreshJavaCommand}" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding InstalledJavaRuntimes}" Margin="0,16,0,0" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,3">
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding MajorDisplay}" FontSize="17" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="1" Text="{Binding VendorDisplay}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ExecutablePath}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="{DynamicResource L10n.main.tab.backups}" Tag="Backups">
                            <Grid Margin="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource L10n.main.backups.heading}" Style="{StaticResource SectionTitle}" />
                                <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource L10n.main.action.createBackup}" Command="{Binding CreateBackupCommand}" Margin="0,0,8,0" />
                                    <Button Content="{DynamicResource L10n.main.backups.openFolder}" Command="{Binding OpenBackupFolderCommand}" Margin="0,0,8,0" />
                                    <Button Content="{DynamicResource L10n.main.backups.openRecoveryPoints}" Command="{Binding OpenRecoveryPointsFolderCommand}"
                                            Visibility="{Binding CanManageLocalRecoveryPoints, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0" />
                                    <Button Content="{DynamicResource L10n.main.backups.restoreRecoveryPoint}" Command="{Binding RestoreRecoveryPointCommand}"
                                            Visibility="{Binding CanManageLocalRecoveryPoints, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0" />
                                    <Button Content="{DynamicResource L10n.main.backups.openCrashReports}" Command="{Binding OpenCrashReportsFolderCommand}" Margin="0,0,8,0" />
                                    <Button Content="{DynamicResource L10n.common.refresh}" Command="{Binding RefreshBackupsCommand}" />
                                </WrapPanel>
                                <ListBox Grid.Row="2" ItemsSource="{Binding SelectedServer.Backups}" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,3">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="170" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" Style="{StaticResource MutedText}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding CreatedDisplay}" Style="{StaticResource MutedText}" />
                                                    <Button Grid.Column="3" Content="{DynamicResource L10n.main.backups.restore}"
                                                            Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsServiceOwned, Converter={StaticResource BoolToVisibility}}"
                                                            Margin="10,0,0,0" Padding="12,4" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <Grid Grid.Column="1" Visibility="{Binding HasSelectedServer, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <Border Width="78" Height="78" Background="{DynamicResource AccentDarkBrush}" CornerRadius="18" Margin="0,0,0,18">
                            <TextBlock Text="◆" Foreground="{DynamicResource AccentBrush}" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{DynamicResource L10n.main.noServers}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource L10n.main.noServersHint}"
                                   Style="{StaticResource MutedText}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,20" />
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource L10n.main.onlineModpack}" Command="{Binding InstallOnlineModpackCommand}" Margin="0,0,8,8" />
                            <Button Content="{DynamicResource L10n.main.importServer}" Command="{Binding ImportExistingServerCommand}" Margin="0,0,8,8" />
                            <Button Content="{DynamicResource L10n.main.createCore}" Command="{Binding CreateCoreServerCommand}" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" FontSize="11"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" />
                    <Button Grid.Column="1"
                            Content="{DynamicResource L10n.main.service.updateAction}"
                            Command="{Binding UpdateProductServiceCommand}"
                            Visibility="{Binding ShowProductServiceUpdateAction, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{DynamicResource L10n.main.service.updateTooltip}"
                            AutomationProperties.Name="{DynamicResource L10n.main.service.updateAction}"
                            Style="{StaticResource PrimaryButton}"
                            Height="32" MinWidth="112" Padding="12,4" Margin="0,0,10,0" />
                    <Grid Grid.Column="2" Margin="0,0,8,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="7" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding BackgroundJobActivity}" Style="{StaticResource MutedText}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Height="5"
                                     Value="{Binding BackgroundJobProgress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsBackgroundJobProgressIndeterminate, Mode=OneWay}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource WindowBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                    </Grid>
                    <Button Grid.Column="3" Content="☰" Command="{Binding OpenBackgroundJobsCommand}"
                            Width="34" Height="32" MinWidth="34" Padding="4" FontSize="17"
                            ToolTip="{DynamicResource L10n.main.jobsTooltip}" AutomationProperties.Name="{DynamicResource L10n.main.jobsTooltip}" />
                    <TextBlock Grid.Column="4" Text="{Binding VersionText}" Style="{StaticResource MutedText}"
                               FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>
            </Border>
        </Grid>
        <views:ClientWorkspaceView DataContext="{Binding ClientWorkspace}"
                                   Visibility="{Binding DataContext.IsClientWorkspace,
                                                        RelativeSource={RelativeSource AncestorType={x:Type Window}},
                                                        Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Window>
