<UserControl x:Class="MinecraftServerManager.App.Controls.RevealPasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             LostKeyboardFocus="OnLostKeyboardFocus"
             Unloaded="OnUnloaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <PasswordBox x:Name="MaskedInput"
                     Grid.Column="0"
                     MaxLength="{Binding MaxLength, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     PasswordChanged="OnMaskedPasswordChanged" />
        <TextBox x:Name="RevealedInput"
                 Grid.Column="0"
                 Visibility="Collapsed"
                 MaxLength="{Binding MaxLength, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 TextChanged="OnRevealedTextChanged"
                 FontFamily="Cascadia Mono, Consolas" />
        <Button x:Name="RevealButton"
                Grid.Column="1"
                Content="👁"
                ToolTip="{DynamicResource L10n.password.reveal}"
                AutomationProperties.Name="{DynamicResource L10n.password.reveal}"
                MinWidth="42"
                Margin="6,0,0,0"
                Click="OnRevealClicked" />
    </Grid>
</UserControl>
