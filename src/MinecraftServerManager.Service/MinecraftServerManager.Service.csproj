<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Muhun MCSV Service</AssemblyName>
    <RootNamespace>MinecraftServerManager.Service</RootNamespace>
    <Version>1.2.9-beta.8</Version>
    <AssemblyVersion>1.2.9.0</AssemblyVersion>
    <FileVersion>1.2.9.0</FileVersion>
    <InformationalVersion>1.2.9-beta.8</InformationalVersion>
    <AssemblyTitle>X MCSV Service</AssemblyTitle>
    <Authors>Muhun</Authors>
    <Company>Muhun</Company>
    <Product>X MCSV</Product>
    <Copyright>Copyright © Muhun 2026</Copyright>
    <Description>Background service host for X MCSV.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MinecraftServerManager.Contracts\MinecraftServerManager.Contracts.csproj" />
    <ProjectReference Include="..\MinecraftServerManager.Core\MinecraftServerManager.Core.csproj" />
    <ProjectReference Include="..\MinecraftServerManager.Data\MinecraftServerManager.Data.csproj" />
    <ProjectReference Include="..\MinecraftServerManager.Notifications\MinecraftServerManager.Notifications.csproj" />
    <ProjectReference Include="..\MinecraftServerManager.ProviderHost\MinecraftServerManager.ProviderHost.csproj" />
    <ProjectReference Include="..\MinecraftServerManager.Remote\MinecraftServerManager.Remote.csproj" />
    <ProjectReference Include="..\MinecraftServerManager.Updater\MinecraftServerManager.Updater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MinecraftServerManager.Service.Tests" />
  </ItemGroup>

</Project>
