<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Muhun MCSV Setup</AssemblyName>
    <RootNamespace>MinecraftServerManager.Installer</RootNamespace>
    <Version>1.2.9-beta.10</Version>
    <AssemblyVersion>1.2.9.0</AssemblyVersion>
    <FileVersion>1.2.9.0</FileVersion>
    <InformationalVersion>1.2.9-beta.10</InformationalVersion>
    <AssemblyTitle>X MCSV Setup</AssemblyTitle>
    <Product>X MCSV</Product>
    <Description>Single-file, elevated installer for X MCSV.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MinecraftServerManager.Updater\MinecraftServerManager.Updater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MinecraftServerManager.Updater.Tests" />
  </ItemGroup>

  <!-- The Updater is referenced as a class library by Setup. Its executable runtimeconfig is
       not used by the installer and must never become a second release deliverable. -->
  <Target Name="RemoveReferencedUpdaterRuntimeConfig" AfterTargets="Publish">
    <Delete Files="$(PublishDir)Muhun MCSV Updater.runtimeconfig.json" />
  </Target>

</Project>
